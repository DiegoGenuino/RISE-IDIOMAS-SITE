---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import cautionTape from '../assets/images/404/caution-tape.png';
import mousePointer from '../assets/icons/mouse-pointer.svg';
---

<style>
  /* ── Global overrides ── */
  :global(body) {
    position: relative;
    overflow-x: hidden;
    background-color: transparent !important;
  }

  /* Dot pattern overlay */
  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0, 0, 0, 0.1) 1px, transparent 1px);
    background-size: 12px 12px;
    z-index: 1;
    pointer-events: none;
  }

  /* ── Entrance: hide everything until ready ── */
  .scene[data-ready='false'] .anim-el {
    opacity: 0;
  }

  /* ── Entrance keyframes ── */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in-scale {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes slide-in-left {
    from {
      opacity: 0;
      transform: rotate(150deg) translateX(60px);
    }
    to {
      opacity: 1;
      transform: rotate(150deg) translateX(0);
    }
  }

  @keyframes slide-in-bottom {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in-right {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* ── Entrance orchestration (activated when data-ready="true") ── */
  .scene[data-ready='true'] .anim-title {
    animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .scene[data-ready='true'] .anim-subtitle {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .scene[data-ready='true'] .anim-cta {
    animation: fade-in-scale 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  .scene[data-ready='true'] .anim-badge {
    animation: fade-in-right 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
  }

  .scene[data-ready='true'] .anim-tape-top {
    animation: slide-in-left 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .scene[data-ready='true'] .anim-tape-bottom {
    animation: slide-in-bottom 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  /* ── Looping animations ── */
  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.9);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.1);
    }
  }

  .btn-glow {
    animation: glow-pulse 3s ease-in-out infinite;
  }

  /* ── Responsive: landscape phones ── */
  @media (orientation: landscape) and (max-height: 500px) {
    .page-title {
      font-size: 4rem;
      padding: 0.5rem;
    }
    .page-subtitle {
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
    }
    .page-center {
      margin-top: 0;
      gap: 0;
    }
    .page-header {
      top: 0.5rem;
      right: 0.5rem;
    }
    .tape-top {
      width: 300px;
      top: -5rem;
      left: -4rem;
    }
    .tape-bottom {
      bottom: -25rem;
    }
  }

  /* ── Responsive: tablets (~760px) ── */
  @media (min-width: 700px) and (max-width: 900px) {
    .tape-bottom {
      bottom: -12rem;
    }
  }

  /* ── Responsive: desktop (>900px) ── */
  @media (min-width: 901px) {
    .tape-bottom {
      bottom: clamp(-45rem, -40vw, -15rem);
    }
  }

  /* ── Reduced motion: skip animations, show everything ── */
  @media (prefers-reduced-motion: reduce) {
    .scene[data-ready='false'] .anim-el {
      opacity: 1;
    }
    .scene[data-ready='true'] .anim-el {
      animation: none !important;
      opacity: 1;
    }
  }
</style>

<BaseLayout
  seo={{
    title: 'Página não encontrada',
    description:
      'Oops! A página que você está procurando não existe ou foi movida. Volte para a página inicial da Rise Idiomas.',
    type: 'website',
    image: '/favicon.svg',
  }}
>
  <!-- Prevent 404 pages from destroying SEO ranking by keeping search engines out, but allow them to follow links back home -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <main
    class="scene relative flex h-screen w-full flex-col items-center justify-center overflow-hidden bg-[#F4F4F5]"
    data-ready="false"
  >
    <!-- HTTP Error Badge -->
    <div
      class="anim-el anim-badge page-header absolute top-4 right-4 z-20 flex items-center gap-1 font-mono text-sm font-bold text-black md:top-8 md:right-8 md:gap-2 md:text-lg"
    >
      <span>http</span>
      <span>error</span>
      <span class="text-2xl leading-none md:text-4xl">404</span>
    </div>

    <!-- Center Content -->
    <div
      class="page-center relative z-10 -mt-10 flex flex-col items-center gap-2 text-center md:-mt-25"
    >
      <h1
        class="anim-el anim-title page-title p-4 font-mono font-sans text-7xl leading-none tracking-tight text-[#1a1a1a] md:text-[12rem]"
      >
        Oops !
      </h1>
      <p
        class="anim-el anim-subtitle page-subtitle mb-8 font-mono text-2xl tracking-wide text-black/80 md:mb-12"
      >
        Página não encontrada
      </p>

      <!-- CTA Button -->
      <div class="anim-el anim-cta group relative z-10">
        <div
          class="btn-glow pointer-events-none absolute inset-0 rounded-full bg-[#5D5DFF] opacity-75 blur-[20px]"
        >
        </div>
        <a
          href="/"
          class="relative block rounded-full bg-[#6363FF]/74 px-8 py-2.5 text-base font-medium text-white shadow-lg transition-all md:px-12 md:py-3 md:text-lg"
        >
          Home
        </a>
        <div class="pointer-events-none absolute -right-5 -bottom-2.5 z-30 h-8 w-8 drop-shadow-md">
          <Image src={mousePointer} alt="" width={28} height={29} loading="eager" />
        </div>
      </div>
    </div>

    <!-- Caution Tape: Top Left -->
    <div
      class="anim-el anim-tape-top tape-top pointer-events-none absolute -top-20 -left-25 z-0 w-[300px] blur-[2px] md:-top-40 md:-left-50 md:w-[600px]"
    >
      <Image src={cautionTape} alt="" class="h-full w-full object-contain" loading="eager" />
    </div>

    <!-- Caution Tape: Bottom -->
    <div
      class="anim-el anim-tape-bottom tape-bottom pointer-events-none absolute -bottom-[2.5rem] z-[1] w-full blur-[4px] md:blur-[6px]"
    >
      <Image src={cautionTape} alt="" class="h-full w-full object-contain" loading="eager" />
    </div>
  </main>

  <!-- Reveal only after images are decoded -->
  <script>
    const scene = document.querySelector('.scene') as HTMLElement;
    if (scene) {
      const imgs = Array.from(scene.querySelectorAll('img'));
      const ready = () => (scene.dataset.ready = 'true');

      if (imgs.length === 0) {
        ready();
      } else {
        Promise.all(imgs.map((img) => img.decode().catch(() => {}))).then(ready);
        // Safety net: reveal after 1.2s regardless
        setTimeout(ready, 1200);
      }
    }
  </script>
</BaseLayout>
