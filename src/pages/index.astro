---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import Hero from '../sections/hero/Hero.astro';
import SocialProof from '../sections/social-proof/SocialProof.astro';
import StickyFeatureGrid from '../sections/methodology/StickyFeatureGrid.astro';
import Courses from '../sections/courses/Courses.astro';
import LevelQuizSection from '../sections/level-quiz/LevelQuizSection.astro';
import Pricing from '../sections/pricing/Pricing.astro';
import Testimonials from '../sections/testimonials/Testimonials.astro';
import Faq from '../sections/faq/Faq.astro';
import CTA from '../sections/cta/CTA.astro';
import Footer from '../sections/footer/Footer.astro';
import WhatsAppFab from '../components/whatsapp-fab/WhatsAppFab.astro';
import Analytics from '@vercel/analytics/astro';

import { courses } from '../data/courses';
import { faq } from '../data/faq';
import { site } from '../data/site';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Rise Idiomas',
  description:
    'Escola de idiomas com aulas conduzidas 100% no idioma-alvo, do inglês para carreiras tech ao preparatório Cambridge e Michigan.',
  logo: new URL('/favicon.svg', Astro.url).toString(),
  url: Astro.url.origin,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'São Paulo',
    addressRegion: 'SP',
    addressCountry: 'BR',
    streetAddress: site.address,
  },
  sameAs: [
    'https://www.instagram.com/rise.idiomas/',
    'https://www.linkedin.com/company/riseidiomas/',
    'https://www.facebook.com/riseidiomasprep/',
    'https://www.youtube.com/@rise.idiomas',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Modalidades',
    itemListElement: courses.map((course) => ({
      '@type': 'Course',
      name: `Inglês ${course.title}`,
      description: course.description,
      provider: { '@type': 'EducationalOrganization', name: 'Rise Idiomas' },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  seo={{
    title: 'Inglês para carreiras tech e fluência jovem',
    description:
      'Aulas conduzidas 100% no idioma, trilha por nível e preparação para Cambridge e Michigan. Inglês, espanhol e português na Vila Carrão, São Paulo.',
    type: 'website',
    image: '/favicon.svg',
  }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Navbar />

  <main id="conteudo">
    <Hero />
    <SocialProof />
    <StickyFeatureGrid />
    <Courses />
    <LevelQuizSection />
    <Pricing />
    <Testimonials />
    <Faq />
    <CTA />
  </main>

  <Footer />
  <WhatsAppFab />
  <Analytics />
</BaseLayout>

<script>
  import { initHome } from '../scripts/main';

  initHome();
</script>
