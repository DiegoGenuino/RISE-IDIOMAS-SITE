---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/Topbar.astro';
import Hero from '../sections/hero/Hero.astro';
import Modalities from '../sections/modalities/Modalities.astro';
import Testimonials from '../sections/testimonials/Testimonials.astro';
import AboutUs from '../sections/about-us/AboutUs.astro';
import Location from '../sections/location/Location.astro';
import CTA from '../sections/cta/CTA.astro';
import Footer from '../sections/footer/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import EnrollmentLetter from '../components/enrollment-letter/EnrollmentLetter.tsx';
import ViewportFallback from '../components/viewport-fallback/ViewportFallback.astro';
---

<style>
  :global(body) {
    position: relative;
  }

  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0;
    /* dotted bg */
    background-image: radial-gradient(rgba(0, 0, 0, 0.1) 1px, transparent 1px);
    background-size: 12px 12px;
    z-index: 1;
    pointer-events: none;
  }

  :global(body) {
    background-color: #f4f4f4 !important;
  }
</style>

<BaseLayout
  seo={{
    title: 'Idiomas Para Todos',
    description:
      'Domine a fluência com a Rise Idiomas. Oferecemos cursos de inglês, espanhol e português desenvolvidos estrategicamente para o seu sucesso no nível executivo, tech, na vida acadêmica e em certificações internacionais.',
    type: 'website',
    image: '/favicon.svg',
  }}
>
  <Fragment slot="head">
    <!-- Google Knowledge Graph / Rich Snippets (Structured Data) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'EducationalOrganization',
        name: 'Rise Idiomas',
        description:
          'Escola de inglês moderna e imersiva focada no ensino de alta performance para adolescentes, executivos e mercado jurídico.',
        logo: new URL('/favicon.svg', Astro.url).toString(),
        url: Astro.url.origin,
        offers: [
          {
            '@type': 'Course',
            name: 'Inglês Executivo',
            description:
              'Foco em nuances culturais, diplomacia corporativa e técnicas de persuasão em inglês avançado.',
          },
          {
            '@type': 'Course',
            name: 'Inglês Acadêmico',
            description: 'Linguagem técnica, produção de artigos e leitura em nível de excelência.',
          },
          {
            '@type': 'Course',
            name: 'Inglês Jurídico',
            description:
              'Terminologia essencial, interpretação de contratos e comunicação assertiva no Direito Internacional.',
          },
        ],
      })}
    />
    <script is:inline type="text/javascript">
      window.onload = function () {
        (function (d, script) {
          script = d.createElement('script');
          script.type = 'text/javascript';
          script.async = true;
          script.src = 'https://w.app/widget-v1/lZVxGu.js';
          d.getElementsByTagName('head')[0].appendChild(script);
        })(document);
      };
    </script>
  </Fragment>
  <div class="relative min-h-screen w-full">
    <Topbar />

    <main
      class="relative flex w-full max-w-[100vw] flex-col gap-26 overflow-x-hidden md:gap-32 lg:gap-20"
    >
      <Hero />
      <Modalities />
      <Testimonials />
      <div class="pointer-events-none flex justify-center">
        <!-- only executes this island when the user scrolls to it -->
        <EnrollmentLetter client:visible />
      </div>
      <AboutUs />
      <Location />
      <!-- div to remove the gap between sections -->
      <div class="mt-10">
        <CTA />
        <Footer />
      </div>
    </main>
  </div>
  <Analytics />
  <ViewportFallback />
</BaseLayout>
