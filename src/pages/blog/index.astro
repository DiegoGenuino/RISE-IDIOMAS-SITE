---
export const prerender = false; // habilita ssr

import { previewAttribute } from '../../lib/sanity.preview-attribute';
import LivePreview from '../../components/blog/LivePreview.astro';
import { isPreviewSession } from '../../lib/sanity.preview';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Footer from '../../sections/footer/Footer.astro';
import { getBlogList } from '../../lib/sanity.blog';
import { Image } from 'astro:assets';
import { stegaClean } from '@sanity/client/stega';

const isPreview = isPreviewSession(Astro.cookies);

const {
  posts,
  categoryFilters,
  errorMessage: blogErrorMessage,
} = await getBlogList(isPreview && Astro.cookies.get('rise-perspective')?.value !== 'published');

if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}

// Log API errors as exceptions for better debugging visibility
if (blogErrorMessage) {
  // eslint-disable-next-line no-console
  console.error(new Error(`[Sanity Blog API] ${blogErrorMessage}`));
}

const featuredPostIndex = posts.findIndex((post) => post.featured);
const normalizedFeaturedPostIndex = featuredPostIndex >= 0 ? featuredPostIndex : 0;
const featuredPost = posts[normalizedFeaturedPostIndex];
const gridPosts = posts.filter((_, index) => index !== normalizedFeaturedPostIndex);
const hasPosts = posts.length > 0;
const featuredCoverImageAlt = featuredPost
  ? featuredPost.image?.alt || `Capa do post "${featuredPost.title}"`
  : 'Capa do post';

function createCategoryKey(categoryLabel: string): string {
  return stegaClean(categoryLabel)
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function createTagKey(tagLabel: string): string {
  return createCategoryKey(tagLabel);
}

const categoriesFromPosts = Array.from(new Set(posts.map((post) => post.category)));
const categoryLabels =
  categoryFilters.length > 0
    ? Array.from(new Set(categoryFilters))
    : Array.from(new Set(categoriesFromPosts));

const filterPills = [
  {
    label: 'Todos',
    key: 'all',
    href: '/blog',
  },
  ...categoryLabels.map((categoryLabel) => {
    const key = createCategoryKey(categoryLabel);

    return {
      label: categoryLabel,
      key,
      href: `/blog?category=${encodeURIComponent(key)}`,
    };
  }),
];

const totalCountFormatted = String(posts.length).padStart(3, '0');
---

<BaseLayout
  seo={{
    title: 'Blog',
    description:
      'Insights práticos sobre fluência, carreira e metodologia para evoluir no inglês com estratégia.',
    type: 'website',
    image: '/favicon.svg',
  }}
>
  <Fragment slot="head"> </Fragment>

  <div class="blog-page">
    <BlogHeader />

    <main id="conteudo" class="ds-shell">
      <section class="page-header" aria-label="Cabeçalho do blog">
        <div class="ph-left">
          <h1 class="ph-hl">
            <span class="ph-hl-inner">Blog<span class="em">.</span></span>
          </h1>
        </div>

        <div class="ph-vr" aria-hidden="true"></div>

        <div class="ph-right">
          <p class="ph-desc">
            Dicas de fluência, estratégias de aprendizado e <strong>conteúdo prático</strong> para quem
            quer ir além do básico no inglês.
          </p>
          <div class="filters" role="group" aria-label="Filtros de categoria">
            {
              filterPills.map((pill, pillIndex) => (
                <a
                  href={pill.href}
                  class={`fpill ${pillIndex === 0 ? 'active' : ''}`}
                  data-filter-pill
                  data-filter-key={pill.key}
                >
                  {pill.label}
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {
        blogErrorMessage && (
          <div class="blog-error-fallback" role="status" aria-live="polite">
            <div class="error-content">
              <h2 class="error-title">Conteúdo indisponível no momento</h2>
              <p class="error-desc">
                Desculpe, não conseguimos carregar os artigos do blog agora. Por favor, tente
                novamente em alguns instantes ou entre em contato conosco.
              </p>
            </div>
          </div>
        )
      }

      {
        !hasPosts && !blogErrorMessage && (
          <p class="blog-alert blog-alert-empty" role="status">
            Nenhum artigo publicado foi encontrado no momento.
          </p>
        )
      }

      {
        featuredPost && (
          <article
            class="featured"
            data-featured
            data-category-key={createCategoryKey(featuredPost.category)}
            data-tag-keys={featuredPost.tags.map(createTagKey).join(',')}
          >
            <div class={`feat-illo ${featuredPost.image?.url ? 'feat-illo-with-image' : ''}`}>
              {featuredPost.image?.url ? (
                <Image
                  class="feat-cover-image"
                  src={featuredPost.image.url}
                  alt={featuredCoverImageAlt}
                  width={featuredPost.image.width ?? 720}
                  height={featuredPost.image.height ?? 720}
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <>
                  <div class="feat-ghost" aria-hidden="true">
                    01
                  </div>
                  <svg
                    viewBox="0 0 280 260"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <rect
                      x="20"
                      y="30"
                      width="160"
                      height="110"
                      rx="14"
                      fill="var(--color-brand)"
                    />
                    <path d="M48 140 L36 162 L72 140Z" fill="var(--color-brand)" />
                    <rect x="32" y="52" width="90" height="8" rx="4" fill="rgba(255,255,255,.35)" />
                    <rect x="32" y="70" width="130" height="6" rx="3" fill="rgba(255,255,255,.2)" />
                    <rect x="32" y="84" width="108" height="6" rx="3" fill="rgba(255,255,255,.2)" />
                    <rect x="32" y="98" width="80" height="6" rx="3" fill="rgba(255,255,255,.15)" />
                    <rect
                      x="98"
                      y="148"
                      width="158"
                      height="90"
                      rx="14"
                      fill="var(--color-surface-alt-2)"
                      stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)"
                      stroke-width="1"
                    />
                    <path
                      d="M232 238 L244 256 L212 238Z"
                      fill="var(--color-surface-alt-2)"
                      stroke="color-mix(in srgb, var(--color-ink) 8%, transparent)"
                      stroke-width="1"
                    />
                    <rect
                      x="112"
                      y="164"
                      width="70"
                      height="7"
                      rx="3.5"
                      fill="color-mix(in srgb, var(--color-ink) 20%, transparent)"
                    />
                    <rect
                      x="112"
                      y="180"
                      width="120"
                      height="5"
                      rx="2.5"
                      fill="color-mix(in srgb, var(--color-ink) 10%, transparent)"
                    />
                    <rect
                      x="112"
                      y="192"
                      width="96"
                      height="5"
                      rx="2.5"
                      fill="color-mix(in srgb, var(--color-ink) 10%, transparent)"
                    />
                    <rect
                      x="112"
                      y="204"
                      width="60"
                      height="5"
                      rx="2.5"
                      fill="color-mix(in srgb, var(--color-ink) 8%, transparent)"
                    />
                    <rect
                      x="60"
                      y="220"
                      width="2"
                      height="20"
                      rx="1"
                      fill="var(--color-brand)"
                      opacity=".6"
                    />
                    <rect
                      x="20"
                      y="220"
                      width="36"
                      height="5"
                      rx="2.5"
                      fill="color-mix(in srgb, var(--color-ink) 15%, transparent)"
                    />
                  </svg>
                </>
              )}
            </div>

            <div class="feat-vr" aria-hidden="true" />

            <a href={`/blog/${featuredPost.slug}`} class="feat-body">
              <div>
                <div class="feat-meta">
                  <span class="feat-tag">{featuredPost.category}</span>
                  <span class="feat-date">{featuredPost.publishDateLabel}</span>
                  <span class="feat-dot">·</span>
                  <span class="feat-read">{featuredPost.readingTimeMinutes} min de leitura</span>
                </div>

                <h2 class="feat-title" data-sanity={previewAttribute(isPreview, featuredPost.id)}>
                  {featuredPost.title}
                </h2>
                <p class="feat-excerpt">{featuredPost.description}</p>
              </div>

              <span class="feat-cta">
                Ler artigo
                <span class="farr">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path
                      d="M2 10L10 2M10 2H4.5M10 2V7.5"
                      stroke="white"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </span>
            </a>
          </article>
        )
      }

      <div class="grid-header">
        <h2 class="gh-title">
          <span class="gh-orbit" aria-hidden="true"><span></span></span>
          Artigos recentes
        </h2>
        <span class="gh-count"
          ><span id="articles-count">{totalCountFormatted}</span> / artigos</span
        >
      </div>

      <div class="articles" role="list" id="blog-articles">
        {
          gridPosts.map((post, postIndex) => (
            <BlogCard
              post={post}
              categoryKey={createCategoryKey(post.category)}
              tagKeys={post.tags.map(createTagKey)}
              animationIndex={postIndex}
            />
          ))
        }
      </div>

      <p id="articles-empty" class="articles-empty" hidden={hasPosts}>
        Nenhum post encontrado para os filtros selecionados.
      </p>

      <section class="nl-strip" aria-label="Inscrição em newsletter">
        <div class="nl-left">
          <div class="nl-signal" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="nl-hl">
            Conteúdo direto<br />no seu <span class="a">e-mail.</span>
          </div>
        </div>
        <div class="nl-vr" aria-hidden="true"></div>
        <form class="nl-right" id="newsletter-form">
          <input
            class="nl-input"
            type="email"
            name="email"
            placeholder="riseidiomas@email.com"
            aria-label="Seu e-mail"
            required
          />
          <button class="nl-btn" type="submit" id="newsletter-submit"
            ><span>Inscrever-se</span></button
          >
        </form>
      </section>
      <!-- Pop up de feedback -->
      <div id="nl-popup" class="animate-slideup fixed right-8 bottom-8 z-50 hidden">
        <div
          class="border-brand-soft bg-surface flex max-w-sm items-center gap-4 rounded-lg border px-6 py-[18px] shadow-lg"
        >
          <span class="text-brand text-2xl" aria-hidden="true">✓</span>

          <div>
            <strong
              class="text-ink mb-1 block font-sans text-sm font-semibold tracking-widest uppercase"
            >
              Inscrição confirmada!
            </strong>
            <p class="text-ink-muted font-sans text-xs leading-relaxed font-light">
              Você receberá nossos conteúdos em breve.
            </p>
          </div>

          <button
            id="nl-popup-close"
            aria-label="Fechar"
            class="text-ink-muted hover:text-ink shrink-0 cursor-pointer self-start border-none bg-transparent p-1 text-sm transition-colors duration-200"
            >✕</button
          >
        </div>
      </div>

      <script is:inline>
        const form = document.getElementById('newsletter-form');
        const submitBtn = document.getElementById('newsletter-submit');
        const popup = document.getElementById('nl-popup');
        const popupClose = document.getElementById('nl-popup-close');
        let popupTimer;

        function hidePopup() {
          popup.classList.remove('animate-slideup');
          popup.classList.add('animate-slidedown');

          popup.addEventListener(
            'animationend',
            () => {
              popup.classList.add('hidden');
              popup.classList.remove('animate-slidedown');
              popup.classList.add('animate-slideup'); // restaura para próxima vez
            },
            { once: true }
          );
        }

        function showPopup() {
          popup.classList.remove('hidden');

          clearTimeout(popupTimer);
          popupTimer = setTimeout(() => popup.classList.add('hidden'), 2000);
        }

        popupClose?.addEventListener('click', () => hidePopup());

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (submitBtn) submitBtn.disabled = true;

          const formData = new FormData(form);

          try {
            const response = await fetch('/api/newsletter', {
              method: 'POST',
              body: formData,
            });

            if (response.ok) {
              form.reset();
              showPopup();
            } else {
              throw new Error('Erro ao assinar newsletter');
            }
          } catch (err) {
            // eslint-disable-next-line no-console
            console.error(err);
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      </script>
    </main>

    <Footer />
  </div>

  <script is:inline>
    (() => {
      const filterPills = Array.from(document.querySelectorAll('[data-filter-pill]'));
      const featuredArticle = document.querySelector('[data-featured]');
      const articleCards = Array.from(document.querySelectorAll('[data-article-card]'));
      const countElement = document.getElementById('articles-count');
      const emptyState = document.getElementById('articles-empty');

      const resolveFiltersFromUrl = () => {
        const searchParams = new URLSearchParams(window.location.search);
        const requestedCategory = (searchParams.get('category') || 'all').toLowerCase();
        const requestedTag = (searchParams.get('tag') || '').toLowerCase();

        const hasCategory = filterPills.some((filterPill) => {
          return (filterPill.dataset.filterKey || '') === requestedCategory;
        });

        return {
          category: hasCategory ? requestedCategory : 'all',
          tag: requestedTag,
        };
      };

      const setActivePill = (activeCategory) => {
        filterPills.forEach((filterPill) => {
          const categoryKey = filterPill.dataset.filterKey || 'all';
          filterPill.classList.toggle('active', categoryKey === activeCategory);
        });
      };

      const hasTagMatch = (rawTagKeys, activeTag) => {
        if (!activeTag) {
          return true;
        }

        const tagKeys = (rawTagKeys || '')
          .split(',')
          .map((tagKey) => tagKey.trim())
          .filter(Boolean);

        return tagKeys.includes(activeTag);
      };

      const applyFilter = (activeCategory, activeTag) => {
        let visibleArticleCount = 0;

        if (featuredArticle) {
          const featuredCategory = featuredArticle.dataset.categoryKey || '';
          const featuredTagKeys = featuredArticle.dataset.tagKeys || '';
          const hasFeaturedCategory =
            activeCategory === 'all' || featuredCategory === activeCategory;
          const hasFeaturedTag = hasTagMatch(featuredTagKeys, activeTag);
          const shouldShowFeatured = hasFeaturedCategory && hasFeaturedTag;
          featuredArticle.hidden = !shouldShowFeatured;

          if (shouldShowFeatured) {
            visibleArticleCount += 1;
          }
        }

        articleCards.forEach((articleCard) => {
          const cardCategory = articleCard.dataset.categoryKey || '';
          const cardTagKeys = articleCard.dataset.tagKeys || '';
          const hasCardCategory = activeCategory === 'all' || cardCategory === activeCategory;
          const hasCardTag = hasTagMatch(cardTagKeys, activeTag);
          const shouldShowCard = hasCardCategory && hasCardTag;
          articleCard.hidden = !shouldShowCard;

          if (shouldShowCard) {
            visibleArticleCount += 1;
          }
        });

        if (emptyState) {
          emptyState.textContent = activeTag
            ? 'Nenhum artigo encontrado para esta combinação de categoria e tag.'
            : 'Nenhum artigo encontrado para esta categoria.';
          emptyState.hidden = visibleArticleCount > 0;
        }

        if (countElement) {
          countElement.textContent = String(visibleArticleCount).padStart(3, '0');
        }

        setActivePill(activeCategory);
      };

      const updateUrl = (activeCategory, activeTag) => {
        const currentUrl = new URL(window.location.href);

        if (activeCategory === 'all') {
          currentUrl.searchParams.delete('category');
        } else {
          currentUrl.searchParams.set('category', activeCategory);
        }

        if (!activeTag) {
          currentUrl.searchParams.delete('tag');
        } else {
          currentUrl.searchParams.set('tag', activeTag);
        }

        const nextUrl = `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`;
        window.history.pushState({}, '', nextUrl);
      };

      filterPills.forEach((filterPill) => {
        filterPill.addEventListener('click', (event) => {
          event.preventDefault();
          const activeCategory = filterPill.dataset.filterKey || 'all';
          const activeTag = '';

          updateUrl(activeCategory, activeTag);
          applyFilter(activeCategory, activeTag);
        });
      });

      window.addEventListener('popstate', () => {
        const { category, tag } = resolveFiltersFromUrl();
        applyFilter(category, tag);
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.14,
        }
      );

      articleCards.forEach((articleCard, articleIndex) => {
        articleCard.style.setProperty('--card-delay', `${articleIndex * 80}ms`);
        revealObserver.observe(articleCard);
      });

      const initialFilters = resolveFiltersFromUrl();
      applyFilter(initialFilters.category, initialFilters.tag);
    })();
  </script>
  <LivePreview enabled={isPreview} />
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    align-items: end;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(4rem, 6vw, 6rem) clamp(3rem, 4vw, 4rem);
  }
  .ph-left {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
  }
  .ph-hl {
    font-size: clamp(6rem, 12vw, 10.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.84;
    white-space: nowrap;
  }
  .ph-hl .em,
  .nl-hl .a {
    color: var(--color-brand);
  }
  .ph-vr,
  .feat-vr,
  .nl-vr {
    display: none;
  }
  .ph-right {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 0.35rem;
  }
  .ph-desc {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-soft);
  }
  .ph-desc strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .fpill {
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .fpill:hover {
    background: var(--color-brand-25);
    color: var(--color-brand);
  }
  .fpill.active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-surface);
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-neutral-50);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
  }
  .featured[hidden] {
    display: none;
  }
  .feat-illo {
    order: 1;
    position: relative;
    min-height: 23rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-brand-25);
    overflow: hidden;
  }
  .feat-cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feat-illo svg {
    width: 65%;
    max-width: 20rem;
  }
  .feat-ghost {
    display: none;
  }
  .feat-body {
    padding: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }
  .feat-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .feat-tag {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .feat-date,
  .feat-read,
  .feat-dot,
  .gh-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .feat-title {
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: 600;
    margin-bottom: 1rem;
    transition: color var(--dur-fast) var(--ease);
  }
  .feat-body:hover .feat-title {
    color: var(--color-brand);
  }
  .feat-excerpt {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .feat-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
  }
  .farr {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-brand);
    transition: transform var(--dur-base) var(--ease);
  }
  .feat-body:hover .farr {
    transform: translate(2px, -2px);
  }
  .grid-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3.5rem 1.5rem;
  }
  .gh-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .gh-orbit {
    position: relative;
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid var(--color-brand-100);
    border-radius: 50%;
  }
  .gh-orbit::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-brand);
  }
  .gh-orbit > span {
    position: absolute;
    inset: -2px;
    animation: gh-orbit-spin 3.6s linear infinite;
  }
  .gh-orbit > span::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--color-aqua);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-aqua) 14%, transparent);
    transform: translateX(-50%);
  }
  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .articles-empty,
  .blog-alert {
