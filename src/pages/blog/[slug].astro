  .art-prose :global(.portable-list-bullet),
  .art-prose :global(.portable-list-number),
  .art-prose :global(.portable-blockquote),
  .art-prose :global(.portable-callout),
  .art-prose :global(.portable-code-block),
  .art-prose :global(.portable-table-wrap),
  .art-prose :global(.portable-embed),
  .art-prose :global(.portable-divider) {
