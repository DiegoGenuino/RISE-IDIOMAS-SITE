---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import RiseLogo from "../../assets/shared/rise-logo.svg";
import type { BlogPost } from "../../types/blog";
import type { SanityPortableBodyNode, SanityPortableTextBlock } from "../../lib/sanity.types";
import { getBlogPostBySlug, getBlogSlugs } from "../../lib/sanity.blog";
import PortableRichContent from "../../components/blog/portable/PortableRichContent.astro";

export const prerender = false;
  
export async function getStaticPaths() {
  const slugs = await getBlogSlugs();

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

type TocLevel = "h2" | "h3" | "h4";

interface ArticleTocItem {
  id: string;
  label: string;
  level: TocLevel;
}

function slugifyHeadingValue(value: string): string {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")
    .slice(0, 96);
}

function extractPortableHeadingLabel(block: SanityPortableTextBlock): string {
  return (block.children || [])
    .map((child) => child.text || "")
    .join("")
    .replace(/\s+/g, " ")
    .trim();
}

function resolvePortableHeadingId(block: SanityPortableTextBlock, label: string): string {
  const normalizedKey = block._key ? slugifyHeadingValue(block._key) : "";
  if (normalizedKey) {
    return `pt-h-${normalizedKey}`;
  }

  const normalizedLabel = slugifyHeadingValue(label);
  return normalizedLabel || "pt-heading";
}

function buildBodyTocItems(body: SanityPortableBodyNode[] | undefined): ArticleTocItem[] {
  if (!Array.isArray(body) || body.length === 0) {
    return [];
  }

  let fallbackIndex = 0;

  return body.flatMap((node) => {
    if (node._type !== "block") {
      return [];
    }

    const level = node.style;
    if (level !== "h2" && level !== "h3" && level !== "h4") {
      return [];
    }

    const label = extractPortableHeadingLabel(node);
    if (!label) {
      return [];
    }

    const id = resolvePortableHeadingId(node, label) || `pt-heading-${++fallbackIndex}`;
    return [{ id, label, level } satisfies ArticleTocItem];
  });
}

const { slug } = Astro.params;
const isPreview = Astro.cookies.get('sanity-preview')?.value === '1';

const {
  post,
  relatedPosts,
  errorMessage: blogErrorMessage,
} = slug
  ? await getBlogPostBySlug(slug, isPreview)
  : {
      post: undefined,
      relatedPosts: [],
      errorMessage: null,
    };

// Log API errors as exceptions for better debugging visibility
if (blogErrorMessage) {
  console.error(new Error(`[Sanity Blog API] ${blogErrorMessage}`));
}

if (!post) {
  return Astro.redirect("/404");
}

const currentPost: BlogPost = post;
const titleLines = currentPost.title ? [currentPost.title] : [];
const hasPortableBody = Boolean(currentPost.portableBody && currentPost.portableBody.length > 0);
const tocItems: ArticleTocItem[] = buildBodyTocItems(currentPost.portableBody);
const hasToc = tocItems.length > 0;
const hasSectionNavigation = false; // We don't have sections anymore
const defaultStats = [
  { label: "Publicado em", valueHtml: currentPost.publishDate },
  { label: "Leitura", valueHtml: `${currentPost.readingTimeMinutes} min` },
  { label: "Categoria", valueHtml: currentPost.category },
];
const hasHeroImage = Boolean(currentPost.image?.url);
const heroImageAlt = currentPost.image?.alt || `Imagem do post ${currentPost.title}`;
const hasAuthorAvatar = Boolean(currentPost.author.avatar?.url);
const authorAvatarAlt = currentPost.author.avatar?.alt || `Foto de ${currentPost.author.name}`;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
  Astro.url.href,
)}`;
const articleImageUrl = currentPost.image?.url ? new URL(currentPost.image.url, Astro.url).toString() : new URL("/favicon.svg", Astro.url).toString();
const articleTags = currentPost.tags.slice(0, 6);
const articlePublishedIso = `${currentPost.publishDate}T00:00:00.000Z`;
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: currentPost.title,
  description: currentPost.description,
  image: [articleImageUrl],
  datePublished: articlePublishedIso,
  dateModified: articlePublishedIso,
  author: {
    "@type": "Person",
    name: currentPost.author.name,
  },
  publisher: {
    "@type": "Organization",
    name: "Rise Idiomas",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.url).toString(),
    },
  },
  mainEntityOfPage: Astro.url.href,
  articleSection: currentPost.category,
  keywords: currentPost.tags.join(", "),
  wordCount: Math.max(currentPost.readingTimeMinutes * 200, 200),
});
---

<BaseLayout
  seo={{
    title: currentPost.title,
    description: currentPost.description,
    type: "article",
    image: currentPost.image?.url || "/favicon.svg",
    canonicalUrl: undefined,
  }}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@300;400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
    <meta property="article:published_time" content={articlePublishedIso} />
    <meta property="og:article:published_time" content={articlePublishedIso} />
    <meta property="article:section" content={currentPost.category} />
    <meta property="og:article:section" content={currentPost.category} />
    <meta property="article:author" content={currentPost.author.name} />
    {
      articleTags.map((tag) => (
        <Fragment>
          <meta property="article:tag" content={tag} />
          <meta property="og:article:tag" content={tag} />
        </Fragment>
      ))
    }
    
    <script type="application/ld+json" set:html={articleJsonLd}></script>
  </Fragment>

  <div class="blog-shell">
    <div id="blog-progress" aria-hidden="true"></div>

    <header class="topbar">
      <a href="/" class="t-logo" aria-label="Ir para página inicial">
        <img src={RiseLogo.src} alt="Rise Idiomas" width="82" height="40" />
      </a>
      <a href="/blog" class="t-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path
            d="M12 7H2M2 7L6 3M2 7L6 11"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        Blog
      </a>
    </header>

    <article>
      {
        blogErrorMessage && (
          <div class="blog-error-fallback" role="status" aria-live="polite">
            <div class="error-icon" aria-hidden="true">⚠</div>
            <div class="error-content">
              <h2 class="error-title">Conteúdo indisponível no momento</h2>
              <p class="error-desc">
                Desculpe, não conseguimos carregar este artigo agora. Por favor, tente novamente em alguns instantes ou volte para a lista de artigos.
              </p>
              <a href="/blog" class="error-cta">
                Voltar para o Blog
              </a>
            </div>
          </div>
        )
      }

      <header class="art-header">
        <div class="ah-left">
          <div class="ah-meta">
            <span class="ah-tag">{currentPost.category}</span>
            <span class="ah-date">{currentPost.publishDateLabel}</span>
            <span class="ah-dot">·</span>
            <span class="ah-read">{currentPost.readingTimeMinutes} min de leitura</span>
          </div>

          <h1 class="ah-title">
            {titleLines.map((line) => (
              <span class="ah-title-row"><span class="ah-title-inner">{line}</span></span>
            ))}
          </h1>
        </div>

        <div class="ah-vr" aria-hidden="true"></div>

        <div class="ah-right">
          <div class="ah-author">
            <div class="ah-avatar">
              {
                hasAuthorAvatar ? (
                  <img
                    class="ah-avatar-image"
                    src={currentPost.author.avatar?.url}
                    alt={authorAvatarAlt}
                    width={currentPost.author.avatar?.width}
                    height={currentPost.author.avatar?.height}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  currentPost.author.initials
                )
              }
            </div>
            <div class="ah-author-info">
              <div class="ah-author-name">{currentPost.author.name}</div>
              <div class="ah-author-role">{currentPost.author.role}</div>
            </div>
          </div>

          <div class="ah-share">
            <span class="ah-share-label">Compartilhar</span>
            <a
              href={linkedInShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn"
              aria-label="Compartilhar no LinkedIn"
            >
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <rect x="1" y="1" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1"></rect>
                <path d="M4 9V6M4 4.5V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                <path
                  d="M7 9V7a1.5 1.5 0 013 0v2M7 6v3"
                  stroke="currentColor"
                  stroke-width="1.1"
                  stroke-linecap="round"
                ></path>
              </svg>
            </a>
            <button id="copy-link-button" class="share-btn" aria-label="Copiar link do artigo">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path
                  d="M5 7.5a3 3 0 004.243.243l1.5-1.5a3 3 0 00-4.243-4.243L5.5 3"
                  stroke="currentColor"
                  stroke-width="1.1"
                  stroke-linecap="round"
                ></path>
                <path
                  d="M8 5.5a3 3 0 00-4.243-.243L2.257 6.757a3 3 0 004.243 4.243L7.5 10"
                  stroke="currentColor"
                  stroke-width="1.1"
                  stroke-linecap="round"
                ></path>
              </svg>
            </button>
          </div>
          <p id="copy-link-feedback" class="copy-feedback" aria-live="polite"></p>
        </div>
      </header>

      <div class="art-hero">
        {
         currentPost.image?.url ? (
            <Image
              class="art-hero-image"
              src={currentPost.image.url}
              alt={heroImageAlt}
              width={currentPost.image.width!}
              height={currentPost.image.height!}
              loading="eager"
              decoding="async"
            />
          ) : (
            <>
              <div class="art-hero-ghost" aria-hidden="true">{"CONTEUDO"}</div>
            
            </>
          )
        }
      </div>

      <div class={`art-body-wrap art-body-wrap-no-sections`}>

        <div class="art-prose" id="prose">
          
          {
            hasPortableBody ? (
              <PortableRichContent body={currentPost.portableBody || []} />
            ) : (
              <p>O conteúdo deste artigo não está disponível em formato portátil.</p>
            )
          }

          <div class="art-tags">
            <span class="art-tags-label">Tags</span>
            {currentPost.tags.map((tag) => <a class="atag" href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
          </div>
        </div>

        <aside class="art-sidebar">
          {
            hasToc && (
              <>
                <div class="toc-label">Neste artigo</div>
                <ul class="toc-list">
                  {
                    tocItems.map((item, index) => (
                      <li class="toc-item">
                        <a
                          href={`#${item.id}`}
                          class={`toc-link toc-level-${item.level} ${index === 0 ? "active" : ""}`}
                        >
                          <span class="toc-n">{String(index + 1).padStart(2, "0")}</span>
                          {item.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </>
            )
          }

          {currentPost.callToAction && (
             <div class="sb-cta">
               <div class="sb-cta-label">Veja mais</div>
               <p class="sb-cta-text">{currentPost.callToAction.title}</p>
               <a href={currentPost.callToAction.url} class="sb-cta-btn">
                 <span>Acessar -></span>
               </a>
             </div>
          )}

          <div class="sb-rel-label">Leia também</div>
          {
            relatedPosts.map((relatedPost) => (
              <a class="sb-rel-item" href={`/blog/${relatedPost.slug}`}>
                <div class="sb-rel-tag">{relatedPost.category}</div>
                <div class="sb-rel-title">{relatedPost.title}</div>
              </a>
            ))
          }
        </aside>
      </div>

      <div class="author-bio">
        <div class="bio-left">
          <div class="bio-avatar">
            {
              hasAuthorAvatar ? (
                <img
                  class="bio-avatar-image"
                  src={currentPost.author.avatar?.url}
                  alt={authorAvatarAlt}
                  width={currentPost.author.avatar?.width}
                  height={currentPost.author.avatar?.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                currentPost.author.initials
              )
            }
          </div>
          <div>
            <div class="bio-name">{currentPost.author.name}</div>
            <div class="bio-role">{currentPost.author.role}</div>
            <p class="bio-text">{currentPost.author.bio}</p>
          </div>
        </div>

        <div class="bio-vr" aria-hidden="true"></div>

        <div class="bio-right">
          <div class="bio-cta-label">Pronto para o próximo nível?</div>
          <div class="bio-cta-hl">
            Dê o <span class="a">salto</span> que você merece.
          </div>
          <a href="https://wa.me/5511948606841" class="bio-btn" target="_blank" rel="noopener noreferrer">
            Fale conosco
            <span class="bio-arr">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2 10L10 2M10 2H4.5M10 2V7.5"
                  stroke="white"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <div class="foot-bar">
        {
          defaultStats.map((stat) => (
            <div class="fb">
              <span class="fb-l">{stat.label}</span>
              <span class="fb-v" set:html={stat.valueHtml}></span>
            </div>
          ))
        }
      </div>
    </article>
  </div>

  <script is:inline>
    (() => {
      const progressBar = document.getElementById("blog-progress");
      const tocLinks = Array.from(document.querySelectorAll(".toc-link"));
      const railNumbers = Array.from(document.querySelectorAll(".rail-num"));

      const sectionElements = tocLinks
        .map((link) => {
          const href = link.getAttribute("href");
          if (!href || !href.startsWith("#")) {
            return null;
          }
          return document.getElementById(href.slice(1));
        })
        .filter((section) => Boolean(section));

      const updateProgress = () => {
        if (!progressBar) {
          return;
        }
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0;
        progressBar.style.width = progress + "%";
      };

      const scrollSidebarToActive = (activeIndex) => {
        const sidebar = document.querySelector(".art-sidebar");
        if (!sidebar) {
          return;
        }

        const activeLink = tocLinks[activeIndex];
        if (!activeLink) {
          return;
        }

        // Get positions relative to viewport
        const linkRect = activeLink.getBoundingClientRect();
        const sidebarRect = sidebar.getBoundingClientRect();

        // Calculate the link's position relative to the sidebar's content
        const linkTopRelativeToSidebar = linkRect.top - sidebarRect.top + sidebar.scrollTop;

        // Position the active link at about 1/4 from the sidebar's top for optimal visibility
        const desiredTopInViewport = sidebarRect.height / 4;
        const targetScroll = linkTopRelativeToSidebar - desiredTopInViewport;

        // Clamp to valid range [0, maxScroll]
        const maxScroll = sidebar.scrollHeight - sidebar.clientHeight;
        const finalScroll = Math.max(0, Math.min(targetScroll, maxScroll));

        // Smooth scroll to the target position
        sidebar.scrollTo({
          top: finalScroll,
          behavior: 'smooth'
        });
      };

      const setActive = (activeIndex) => {
        tocLinks.forEach((link, index) => {
          link.classList.toggle("active", index === activeIndex);
        });

        railNumbers.forEach((railNumber, index) => {
          railNumber.classList.toggle("vis", index <= activeIndex);
          railNumber.classList.toggle("cur", index === activeIndex);
        });

        // Scroll sidebar to show active TOC item
        scrollSidebarToActive(activeIndex);
      };

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            const sectionIndex = sectionElements.indexOf(entry.target);
            if (sectionIndex >= 0) {
              setActive(sectionIndex);
            }
          });
        },
        {
          threshold: 0.3,
          rootMargin: "-80px 0px -42% 0px",
        },
      );

      sectionElements.forEach((section) => {
        sectionObserver.observe(section);
      });

      tocLinks.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          const target = sectionElements[index];
          if (!target) {
            return;
          }
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        });
      });

      const revealTargets = document.querySelectorAll(
        ".art-prose h2, .art-prose h3, .art-prose p, .callout, .pullquote, .art-prose ol, .art-rule, .portable-heading, .portable-paragraph, .portable-callout, .portable-code-block, .portable-table-wrap, .portable-embed, .portable-image, .portable-blockquote, .portable-list-bullet, .portable-list-number",
      );

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.1 },
      );

      revealTargets.forEach((target) => {
        if (target.classList.contains("lead")) {
          return;
        }
        target.classList.add("reveal-item");
        revealObserver.observe(target);
      });

      const copyButton = document.getElementById("copy-link-button");
      const copyFeedback = document.getElementById("copy-link-feedback");

      const showCopyFeedback = (message) => {
        if (!copyFeedback) {
          return;
        }
        copyFeedback.textContent = message;
        window.setTimeout(() => {
          copyFeedback.textContent = "";
        }, 2000);
      };

      if (copyButton) {
        copyButton.addEventListener("click", async () => {
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(window.location.href);
              showCopyFeedback("Link copiado.");
              return;
            }
            window.prompt("Copie o link do artigo:", window.location.href);
            showCopyFeedback("Link pronto para cópia.");
          } catch {
            window.prompt("Copie o link do artigo:", window.location.href);
            showCopyFeedback("Não foi possível copiar automaticamente.");
          }
        });
      }

      setActive(0);
      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
    })();
  </script>
</BaseLayout>

<style>
  :root {
    --cream: #f6f4ef;
    --ink: #111120;
    --blue: #2b2ba8;
    --mid: #8a8a9e;
    --rule: rgba(17, 17, 32, 0.1);
    --rule-strong: rgba(17, 17, 32, 0.2);
    --blog-side-top: 74px;
    --blog-side-max-height: calc(100dvh - 96px);
    --blog-side-padding-block: 52px;
    --blog-side-padding-inline: 26px;
  }

  :global(html),
  :global(body) {
    max-width: 100%;
    overflow-x: clip;
  }

  .blog-shell {
    background: var(--cream);
    color: var(--ink);
    width: 100%;
    overflow-x: clip;
  }

  article {
    max-width: 100%;
    overflow-x: clip;
  }

  .blog-error-fallback {
    margin: 32px 52px;
    padding: 32px;
    border: 1px solid rgba(43, 43, 168, 0.2);
    background: linear-gradient(135deg, rgba(43, 43, 168, 0.08) 0%, rgba(43, 43, 168, 0.03) 100%);
    border-radius: 8px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .error-icon {
    font-size: 28px;
    flex-shrink: 0;
    line-height: 1;
    color: rgba(43, 43, 168, 0.6);
  }

  .error-content {
    flex: 1;
    min-width: 0;
  }

  .error-title {
    margin: 0 0 10px 0;
    font-family: "Bebas Neue", sans-serif;
    font-size: 24px;
    letter-spacing: 0.03em;
    line-height: 1.2;
    color: #111120;
  }

  .error-desc {
    margin: 0 0 16px 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: #8a8a9e;
  }

  .error-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid #2b2ba8;
    background: #2b2ba8;
    color: #f6f4ef;
    text-decoration: none;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .error-cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .blog-alert {
    margin: 20px 44px 0;
    border: 1px solid var(--rule-strong);
    background: rgba(17, 17, 32, 0.04);
    padding: 12px 14px;
    font-family: "DM Sans", sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: var(--mid);
  }

  #blog-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--blue);
    z-index: 200;
    transition: width 120ms linear;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 44px;
    background: rgba(246, 244, 239, 0.93);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .t-logo {
    display: inline-flex;
    align-items: center;
  }

  .t-logo img {
    width: 82px;
    height: auto;
    display: block;
  }

  .t-back {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mid);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 260ms ease, border-color 260ms ease;
  }

  .t-back:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .art-header {
    display: grid;
    grid-template-columns: 1fr 1px 36%;
