---
const phoneNumber = '5511948606841';
const baseMessage =
  'Olá, vim pelo site e gostaria de mais informações sobre os cursos, horários e turmas.';

const options = [
  {
    label: 'Quero saber sobre cursos',
    value: 'Cursos',
  },
  {
    label: 'Horários e turmas',
    value: 'Horários',
  },
  {
    label: 'Valores e planos',
    value: 'Valores',
  },
  {
    label: 'Aula experimental',
    value: 'Aula experimental',
  },
];
---

<div class="min-wa-wrapper" data-phone={phoneNumber} data-base-message={baseMessage}>
  <div class="min-wa-card" id="whatsapp-fab-panel" role="dialog" aria-label="Contato pelo WhatsApp">
    <div class="min-wa-header">
      <span class="min-wa-title">Como posso ajudar?</span>
      <button class="min-wa-close" type="button" aria-label="Fechar">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <ul class="min-wa-list">
      {
        options.map((option) => (
          <li>
            <button class="min-wa-item" type="button" data-option={option.value}>
              <span class="min-wa-text">{option.label}</span>
              <svg
                class="min-wa-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <button class="min-wa-fab" type="button" aria-label="Abrir WhatsApp" aria-expanded="false">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
      ></path>
    </svg>
  </button>
</div>

<style>
  .min-wa-wrapper {
    position: fixed;
    bottom: 32px;
    right: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    z-index: 9999;
    /* O cartão fechado é `opacity: 0` mas continua a ocupar o seu lugar aqui
       dentro, portanto este wrapper mede ~300x400px mesmo com nada visível.
       Sendo `fixed`, engolia todos os cliques no canto inferior — que num
       telemóvel de 390px é praticamente metade do ecrã. Os cliques passam a
       atravessar o wrapper; só o botão e o cartão aberto os recebem. */
    pointer-events: none;
    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .min-wa-card {
    background: #ffffff;
    width: 300px;
    border-radius: 12px;
    border: 1px solid #e5e5e5;
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .min-wa-card.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .min-wa-header {
    padding: 24px 24px 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .min-wa-title {
    color: #111111;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .min-wa-close {
    background: none;
    border: none;
    color: #a1a1aa;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .min-wa-close:hover {
    color: #111111;
  }

  .min-wa-close svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
  }

  .min-wa-list {
    list-style: none;
    padding: 0 12px 12px 12px;
    margin: 0;
  }

  .min-wa-item {
    width: 100%;
    background: none;
    border: none;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .min-wa-item:hover {
    background-color: #f4f4f5;
  }

  .min-wa-text {
    color: #52525b;
    font-size: 14px;
    text-align: left;
    transition: color 0.2s ease;
  }

  .min-wa-item:hover .min-wa-text {
    color: #111111;
  }

  .min-wa-arrow {
    color: #d4d4d8;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .min-wa-item:hover .min-wa-arrow {
    color: #111111;
    transform: translateX(3px);
  }

  .min-wa-fab {
    pointer-events: auto;
    width: 56px;
    height: 56px;
    background-color: #25d366;
    border: 1px solid #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: #ffffff;
  }

  .min-wa-fab:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    border-color: #21c25c;
  }

  .min-wa-fab svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  @media (max-width: 480px) {
    .min-wa-wrapper {
      bottom: 24px;
      right: 24px;
    }
  }
</style>

<script is:inline>
  const fab = document.querySelector('.min-wa-wrapper');
  if (fab) {
    const button = fab.querySelector('.min-wa-fab');
    const panel = fab.querySelector('.min-wa-card');
    const options = fab.querySelectorAll('.min-wa-item');
    const closeButton = fab.querySelector('.min-wa-close');

    const phone = fab.getAttribute('data-phone');
    const baseMessage = fab.getAttribute('data-base-message');

    const togglePanel = () => {
      if (!panel || !button) return;
      const isOpen = panel.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(isOpen));
    };

    const closePanel = () => {
      if (!panel || !button) return;
      panel.classList.remove('is-open');
      button.setAttribute('aria-expanded', 'false');
    };

    button?.addEventListener('click', togglePanel);
    closeButton?.addEventListener('click', closePanel);

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const selected = option.getAttribute('data-option');
        const textParts = [baseMessage];

        if (selected) {
          textParts.push(`Interesse: ${selected}.`);
        }

        const message = encodeURIComponent(textParts.filter(Boolean).join(' '));
        const url = `https://wa.me/${phone}?text=${message}`;

        window.open(url, '_blank', 'noopener');
        closePanel();
      });
    });

    document.addEventListener('click', (event) => {
      if (!panel || !fab) return;
      const target = event.target;
      if (target instanceof Node && !fab.contains(target)) {
        closePanel();
      }
    });
  }
</script>
