---
import HamburguerOpenedSvg from '../../../assets/icons/hamburguer-opened.svg?raw';
import MenuLinkBg from '../../../assets/icons/menu-link-bg.svg';
---

<!-- Mobile Menu Overlay -->
<div
  id="menu-overlay"
  class="menu-overlay fixed inset-0 z-50 flex flex-col justify-center px-8 md:px-20"
>
  <!-- Glass Background removed (handled in CSS) -->

  <button
    id="menu-close"
    class="absolute top-[13px] right-4 z-50 cursor-pointer md:top-[33px] md:right-12"
    aria-label="Close menu"
  >
    <div class="h-[36px] w-[44px] md:h-[46px] md:w-[56px]">
      <Fragment set:html={HamburguerOpenedSvg} />
    </div>
  </button>

  <!-- Navigation Links -->
  <nav class="relative z-10 flex flex-col gap-4 pl-8 md:gap-6 md:pl-20">
    <div class="menu-item-wrapper group">
      <span
        class="mr-2 text-lg font-light text-[#4242A5] opacity-80 select-none md:mr-4 md:text-2xl"
        >1.</span
      >
      <a
        href="/"
        class="menu-link relative inline-block text-left text-[3.5rem] leading-none font-thin tracking-tight text-[#4242A5] md:text-8xl"
      >
        <span class="relative z-10">/home</span>
        <img
          src={MenuLinkBg.src}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[250%] w-[250%] origin-center -translate-x-1/2 -translate-y-1/2 scale-150 object-contain opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-75"
        />
      </a>
    </div>

    <div class="menu-item-wrapper group">
      <span
        class="mr-2 text-lg font-light text-[#4242A5] opacity-80 select-none md:mr-4 md:text-2xl"
        >2.</span
      >
      <a
        href="/blog"
        class="menu-link relative inline-block text-left text-[3.5rem] leading-none font-thin tracking-tight text-[#4242A5] md:text-8xl"
      >
        <span class="relative z-10">/blog</span>
        <img
          src={MenuLinkBg.src}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[250%] w-[250%] origin-center -translate-x-1/2 -translate-y-1/2 scale-150 object-contain opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-75"
        />
      </a>
    </div>

    <div class="menu-item-wrapper group">
      <span
        class="mr-2 text-lg font-light text-[#4242A5] opacity-80 select-none md:mr-4 md:text-2xl"
        >3.</span
      >
      <a
        href="/sobre"
        class="menu-link relative inline-block text-left text-[3.5rem] leading-none font-thin tracking-tight text-[#4242A5] md:text-8xl"
      >
        <span class="relative z-10">/sobre</span>
        <img
          src={MenuLinkBg.src}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[250%] w-[250%] origin-center -translate-x-1/2 -translate-y-1/2 scale-150 object-contain opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-75"
        />
      </a>
    </div>

  </nav>
</div>

<style>
  .menu-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms cubic-bezier(0.25, 1, 0.5, 1);
    background: rgba(245, 245, 250, 0.25); /* More transparent for glass effect */
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Flex wrapper to align number and text */
  .menu-item-wrapper {
    display: flex;
    align-items: baseline;
    transform: translateX(-20px);
    opacity: 0;
    transition:
      transform 400ms cubic-bezier(0.25, 1, 0.5, 1),
      opacity 400ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .menu-overlay.active .menu-item-wrapper {
    transform: translateX(0);
    opacity: 1;
  }

  .menu-overlay.active .menu-item-wrapper:nth-child(1) {
    transition-delay: 100ms;
  }
  .menu-overlay.active .menu-item-wrapper:nth-child(2) {
    transition-delay: 200ms;
  }
  .menu-overlay.active .menu-item-wrapper:nth-child(3) {
    transition-delay: 300ms;
  }
  .menu-overlay.active .menu-item-wrapper:nth-child(4) {
    transition-delay: 400ms;
  }

  /* Ensure inlined SVG fills wrapper */
  #menu-close :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Override local SVG color for the close button to match the dark theme on light bg */
  #menu-close :global(path) {
    fill: #4242a5;
  }
</style>
