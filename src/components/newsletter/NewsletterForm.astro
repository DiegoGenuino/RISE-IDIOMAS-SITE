---
/**
 * Inscrição na newsletter.
 * Mantém o contrato do endpoint já existente em src/pages/api/newsletter.ts
 * (POST multipart com o campo `email`) e degrada para submit nativo sem JS.
 */
---

<form class="ds-news" action="/api/newsletter" method="post" data-newsletter novalidate>
  <label class="sr-only" for="newsletter-email">Seu e-mail</label>

  <div class="ds-news-row">
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="seu@email.com"
      class="ds-news-input"
      data-newsletter-input
    />
    <button type="submit" class="ds-news-submit" data-newsletter-submit>
      <span data-newsletter-label>Inscrever</span>
    </button>
  </div>

  <p class="ds-news-status" role="status" aria-live="polite" data-newsletter-status></p>
</form>

<style>
  .ds-news {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 31rem;
  }

  .ds-news-row {
    display: flex;
    gap: 0.55rem;
    padding: 0.28rem;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    background: rgba(7, 23, 47, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .ds-news-input {
    flex: 1;
    min-width: 0;
    height: 3rem;
    padding-inline: 1rem;
    border-radius: 999px;
    background-color: transparent;
    box-shadow: none;
    color: #fff;
    font-size: 0.875rem;
    transition: box-shadow 0.2s ease;
  }

  .ds-news-input::placeholder {
    color: rgba(255, 255, 255, 0.62);
  }

  .ds-news-input:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.52);
  }

  .ds-news-submit {
    height: 3rem;
    padding-inline: 1.35rem;
    border-radius: 999px;
    background-color: #fff;
    color: #102a40;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .ds-news-submit:hover:not(:disabled) {
    color: #fff;
    background-color: #4f46e5;
    transform: translateY(-1px);
  }

  .ds-news-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .ds-news-status {
    min-height: 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding-left: 1rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .ds-news-status[data-state='ok'] {
    color: var(--color-lime);
  }

  .ds-news-status[data-state='error'] {
    color: #ff9db5;
  }

  @media (max-width: 479px) {
    .ds-news-row {
      padding: 0.25rem;
    }

    .ds-news-input {
      width: 100%;
      padding-inline: 0.8rem;
      font-size: 0.8rem;
    }

    .ds-news-submit {
      padding-inline: 1rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');

  if (form) {
    const input = form.querySelector<HTMLInputElement>('[data-newsletter-input]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-newsletter-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-newsletter-label]')!;
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.dataset.state = 'error';
        status.textContent = 'Confira o e-mail digitado.';
        input.focus();
        return;
      }

      submit.disabled = true;
      label.textContent = 'Enviando…';
      status.removeAttribute('data-state');
      status.textContent = '';

      try {
        const body = new FormData();
        body.append('email', email);

        const response = await fetch('/api/newsletter', { method: 'POST', body });
        const payload = await response.json().catch(() => ({}));

        if (!response.ok) throw new Error(payload.error ?? 'Não foi possível concluir.');

        status.dataset.state = 'ok';
        status.textContent = 'Inscrição confirmada. Confira sua caixa de entrada.';
        form.reset();
      } catch (error) {
        status.dataset.state = 'error';
        status.textContent =
          error instanceof Error ? error.message : 'Não foi possível concluir agora.';
      } finally {
        submit.disabled = false;
        label.textContent = 'Inscrever';
      }
    });
  }
</script>
