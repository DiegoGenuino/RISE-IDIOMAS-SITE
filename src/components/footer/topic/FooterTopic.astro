---
interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  links: LinkItem[][];
}

const { title, links } = Astro.props;
---

<div class="h-fit w-fit">
  <h4 class="mb-4 text-lg font-semibold text-[#1a1a2e]">{title}</h4>
  <div class="flex gap-8">
    {
      links.map((column) => (
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {column.map((item) => (
            <li>
              <a
                href={item.url}
                class="text-[0.95rem] text-[#555] no-underline transition-colors duration-200 hover:text-[#4a4a9e]"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
