---
import { isPreviewSession } from '../../lib/sanity.preview';
import { previewAttribute } from '../../lib/sanity.preview-attribute';
import type { BlogPost } from '../../types/blog';
import { Image } from 'astro:assets';

interface Props {
  post: BlogPost;
  categoryKey: string;
  tagKeys?: string[];
  animationIndex?: number;
}

const { post, categoryKey, tagKeys = [], animationIndex = 0 } = Astro.props;

const cardDelay = `${Math.min(animationIndex, 10) * 80}ms`;

function renderCardIllustration(categoryFilterKey: string): string {
  if (categoryFilterKey === 'carreira') {
    return `<svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="360" height="180" fill="color-mix(in srgb, var(--color-ink) 3%, transparent)"/><rect x="100" y="36" width="160" height="108" rx="4" fill="var(--color-surface-alt-2)" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><rect x="100" y="36" width="160" height="18" rx="4" fill="var(--color-brand)"/><rect x="120" y="72" width="80" height="7" rx="3.5" fill="color-mix(in srgb, var(--color-ink) 20%, transparent)"/><rect x="130" y="88" width="60" height="5" rx="2.5" fill="color-mix(in srgb, var(--color-ink) 12%, transparent)"/><circle cx="180" cy="116" r="14" fill="none" stroke="var(--color-brand)" stroke-width="1.2"/><path d="M173 116 L178 121 L187 111" stroke="var(--color-brand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="128" cy="116" r="4" fill="#F0C44A"/><circle cx="232" cy="116" r="4" fill="#F0C44A"/></svg>`;
  }

  if (categoryFilterKey === 'dicas') {
    return `<svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="360" height="180" fill="color-mix(in srgb, var(--color-ink) 3%, transparent)"/><rect x="104" y="110" width="28" height="40" rx="2" fill="var(--color-surface-alt-2)" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><rect x="144" y="80" width="28" height="70" rx="2" fill="var(--color-neutral-100)" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><rect x="184" y="55" width="28" height="95" rx="2" fill="var(--color-brand)"/><rect x="224" y="70" width="28" height="80" rx="2" fill="var(--color-neutral-100)" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><line x1="96" y1="150" x2="264" y2="150" stroke="color-mix(in srgb, var(--color-ink) 15%, transparent)" stroke-width="1"/><polyline points="118,126 158,96 198,68 238,84" stroke="var(--color-brand)" stroke-width="1.5" fill="none" stroke-dasharray="4 3"/></svg>`;
  }

  if (categoryFilterKey === 'fluencia') {
    return `<svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="360" height="180" fill="color-mix(in srgb, var(--color-ink) 3%, transparent)"/><path d="M130 90 C130 62 154 40 180 40 C206 40 230 62 230 90" stroke="color-mix(in srgb, var(--color-ink) 18%, transparent)" stroke-width="2" fill="none"/><rect x="116" y="88" width="20" height="36" rx="6" fill="var(--color-brand)"/><rect x="224" y="88" width="20" height="36" rx="6" fill="var(--color-brand)"/><path d="M152 98 C152 90 172 84 180 84 C188 84 208 90 208 98" stroke="color-mix(in srgb, var(--color-brand) 30%, transparent)" stroke-width="1.2" fill="none"/><path d="M160 112 C160 100 172 94 180 94 C188 94 200 100 200 112" stroke="color-mix(in srgb, var(--color-brand) 50%, transparent)" stroke-width="1" fill="none"/></svg>`;
  }

  return `<svg viewBox="0 0 360 180" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="360" height="180" fill="color-mix(in srgb, var(--color-ink) 3%, transparent)"/><circle cx="180" cy="90" r="56" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><ellipse cx="180" cy="90" rx="28" ry="56" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><line x1="124" y1="90" x2="236" y2="90" stroke="color-mix(in srgb, var(--color-ink) 10%, transparent)" stroke-width="1"/><line x1="131" y1="62" x2="229" y2="62" stroke="color-mix(in srgb, var(--color-ink) 7.000000000000001%, transparent)" stroke-width="1"/><line x1="131" y1="118" x2="229" y2="118" stroke="color-mix(in srgb, var(--color-ink) 7.000000000000001%, transparent)" stroke-width="1"/><circle cx="180" cy="90" r="8" fill="var(--color-brand)"/></svg>`;
}

const cardIllustrationSvg = renderCardIllustration(categoryKey);
---

<article
  class="card"
  role="listitem"
  data-sanity={previewAttribute(isPreviewSession(Astro.cookies), post.id)}
  data-article-card
  data-category-key={categoryKey}
  data-tag-keys={tagKeys.join(',')}
  style={`--card-delay:${cardDelay};`}
>
  <a class="card-link" href={`/blog/${post.slug}`}>
    <div class="card-img">
      {
        post.image?.url ? (
          <Image
            class="card-cover-image"
            src={post.image.url}
            alt={post.image.alt || `Capa do post ${post.title}`}
            width={post.image.width ?? 720}
            height={post.image.height ?? 720}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Fragment set:html={cardIllustrationSvg} />
        )
      }
    </div>

    <div class="card-body">
      <div class="card-meta">
        <span class="card-tag">{post.category}</span>
        <span class="card-date">{post.publishDateLabel}</span>
      </div>

      <h3 class="card-title">{post.title}</h3>
      <p class="card-excerpt">{post.description}</p>

      <div class="card-foot">
        <span class="card-read">{post.readingTimeMinutes} min</span>
        <span class="card-arr" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path
              d="M2 10L10 2M10 2H4.5M10 2V7.5"
              stroke="var(--color-ink)"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-neutral-50);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    transition:
      box-shadow var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .card[hidden] {
    display: none;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .card-img {
    aspect-ratio: 16 / 9;
    background: var(--color-brand-25);
    overflow: hidden;
  }
  .card-img :global(svg),
  .card-cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .card-tag {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .card-date,
  .card-read {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .card-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }
  .card-excerpt {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin-bottom: 1.5rem;
  }
  .card-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-neutral-50);
    padding-top: 1rem;
  }
  .card-arr {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-brand);
    border-radius: var(--radius-md);
    background: var(--color-brand-25);
  }
  .card-arr :global(path) {
    stroke: currentColor;
  }
  .card:hover,
  .card:focus-within {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .card:hover .card-title {
    color: var(--color-brand);
  }
  .card-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -3px;
    border-radius: var(--radius-lg);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
