---
import type { SanityPtCalloutBlock } from '../../../lib/sanity.types';
import PortableTextBlock from './PortableTextBlock.astro';
import { stegaClean } from '@sanity/client/stega';

interface Props {
  block: SanityPtCalloutBlock;
}

const { block } = Astro.props;
const tone = stegaClean(block.tone || 'info');
const contentBlocks = block.content || [];
---

<div class={`portable-callout tone-${tone}`}>
  {block.title && <div class="portable-callout-title">{block.title}</div>}
  <div class="portable-callout-content">
    {contentBlocks.map((contentBlock) => <PortableTextBlock block={contentBlock} compact />)}
  </div>
</div>

<style>
  .portable-callout {
    margin: 30px 0;
    padding: 20px 24px;
    border-left: 2px solid var(--color-brand);
    background: color-mix(in srgb, var(--color-brand) 5%, transparent);
  }

  .portable-callout-title {
    margin-bottom: 8px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .tone-info {
    border-left-color: var(--color-brand);
    background: color-mix(in srgb, var(--color-brand) 6%, transparent);
  }

  .tone-info .portable-callout-title {
    color: var(--color-brand);
  }

  .tone-warning {
    border-left-color: #c87100;
    background: rgba(200, 113, 0, 0.1);
  }

  .tone-warning .portable-callout-title {
    color: #8d4d00;
  }

  .tone-success {
    border-left-color: #147d44;
    background: rgba(20, 125, 68, 0.1);
  }

  .tone-success .portable-callout-title {
    color: #147d44;
  }

  .tone-neutral {
    border-left-color: color-mix(in srgb, var(--color-ink) 32%, transparent);
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  .tone-neutral .portable-callout-title {
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  @media (max-width: 900px) {
    .portable-callout {
      margin: 28px 0;
      padding: 18px 20px;
    }

    .portable-callout-title {
      margin-bottom: 7px;
    }
  }

  @media (max-width: 600px) {
    .portable-callout {
      margin: 22px 0;
      padding: 14px;
    }

    .portable-callout-title {
      margin-bottom: 6px;
      letter-spacing: 0.04em;
    }
  }
</style>
