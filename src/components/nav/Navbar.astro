---
import riseLogo from '../../assets/shared/rise-logo.svg';
import Button from '../ui/Button.astro';
import AudienceSwitch from '../ui/AudienceSwitch.astro';
import { ctaLinks } from '../../data/site';

const navLinks = [
  { label: 'Modalidades', target: 'modalidades' },
  { label: 'Metodologia', target: 'metodologia' },
  { label: 'Trilha', target: 'trilha' },
  { label: 'Planos', target: 'planos' },
];

const drawerLinks = [...navLinks, { label: 'Teste de nível', target: 'nivel' }];
---

<header id="site-nav" class="ds-nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="ds-shell ds-nav-wrap">
    <div class="ds-nav-surface">
      <a href="/" class="ds-nav-brand" aria-label="Rise Idiomas — início">
        <img
          src={riseLogo.src}
          alt=""
          width="31"
          height="26"
          draggable="false"
          fetchpriority="high"
        />
        <span>Rise Idiomas</span>
      </a>

      <nav class="ds-nav-links" aria-label="Navegação principal">
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <button type="button" data-scroll-to={link.target} class="ds-nav-link">
                  {link.label}
                </button>
              </li>
            ))
          }
          <li><a href="/blog" class="ds-nav-link">Blog</a></li>
        </ul>
      </nav>

      <div class="ds-nav-actions">
        <div class="ds-nav-cta">
          <Button href={ctaLinks.trial} size="sm" class="rounded-md! px-3.5!">
            Agendar aula
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="ds-arrow"
            >
              <path d="M5 12h13M12 5l7 7-7 7"></path>
            </svg>
          </Button>
        </div>

        <button
          type="button"
          id="nav-toggle"
          class="ds-burger-btn"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="nav-drawer"
        >
          <span class="ds-burger" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="nav-drawer" class="ds-drawer" data-drawer inert>
    <div class="ds-drawer-inner">
      <div class="ds-drawer-item ds-drawer-profile" style="--i:0">
        <span class="ds-mono text-ink-muted">Conteúdo para</span>
        <AudienceSwitch size="bar" />
      </div>

      <div class="ds-drawer-item" style="--i:1">
        <ul class="ds-drawer-links">
          {
            drawerLinks.map((link, index) => (
              <li>
                <button type="button" data-scroll-to={link.target} class="ds-drawer-link">
                  <span class="ds-drawer-index">0{index + 1}</span>
                  {link.label}
                </button>
              </li>
            ))
          }
          <li>
            <a href="/blog" class="ds-drawer-link">
              <span class="ds-drawer-index">06</span>
              Blog
            </a>
          </li>
        </ul>
      </div>

      <div class="ds-drawer-item" style="--i:2">
        <Button href={ctaLinks.trial} size="lg" class="w-full">Agendar aula experimental</Button>
      </div>
    </div>
  </div>
</header>

<style>
  .ds-nav {
    padding-top: clamp(0.5rem, 1.2vw, 0.75rem);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .ds-nav[data-hidden] {
    transform: translate3d(0, calc(-100% - 0.75rem), 0);
  }

  .ds-nav-wrap {
    position: relative;
    z-index: 2;
  }

  .ds-nav-surface {
    display: flex;
    height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.375rem 0.5rem 0.375rem 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.875rem;
    background-color: color-mix(in srgb, var(--color-surface) 70%, transparent);
    box-shadow: 0 1px 0 rgb(6 27 49 / 0.03);
    -webkit-backdrop-filter: blur(14px) saturate(1.35);
    backdrop-filter: blur(14px) saturate(1.35);
    transition:
      background-color var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-expo),
      box-shadow var(--dur-base) var(--ease-out-expo);
  }

  [data-nav][data-stuck] .ds-nav-surface,
  [data-nav][data-open] .ds-nav-surface {
    border-color: color-mix(in srgb, var(--color-brand-100) 78%, transparent);
    background-color: color-mix(in srgb, var(--color-surface) 91%, transparent);
    box-shadow:
      0 12px 36px -16px rgb(6 27 49 / 0.2),
      0 2px 8px rgb(6 27 49 / 0.05);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .ds-nav-surface,
    [data-nav][data-stuck] .ds-nav-surface {
      background-color: var(--color-surface);
    }
  }

  .ds-nav-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .ds-nav-brand img {
    width: auto;
    height: 1.5rem;
    user-select: none;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .ds-nav-brand:hover img {
    transform: rotate(-4deg) scale(1.04);
  }

  .ds-nav-links {
    display: none;
  }

  .ds-nav-links ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .ds-nav-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.6875rem;
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    font-weight: 520;
    line-height: 1;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .ds-nav-link::after {
    content: '';
    position: absolute;
    right: 0.6875rem;
    bottom: 0.2rem;
    left: 0.6875rem;
    height: 1px;
    background-color: var(--color-brand);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  .ds-nav-link:hover {
    color: var(--color-ink);
  }

  .ds-nav-link:hover::after,
  .ds-nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .ds-nav-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.25rem;
  }

  .ds-nav-cta {
    display: none;
  }

  .ds-burger-btn {
    display: grid;
    width: 2.625rem;
    height: 2.625rem;
    place-items: center;
    border-radius: 0.625rem;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .ds-burger-btn:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-25);
  }

  .ds-burger,
  .ds-burger::before,
  .ds-burger::after {
    display: block;
    width: 17px;
    height: 1.5px;
    border-radius: 2px;
    background-color: currentColor;
    transition:
      transform 0.35s var(--ease-out-expo),
      background-color 0.2s var(--ease);
  }

  .ds-burger {
    position: relative;
  }

  .ds-burger::before,
  .ds-burger::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .ds-burger::before {
    transform: translateY(-5px);
  }

  .ds-burger::after {
    transform: translateY(5px);
  }

  #nav-toggle[aria-expanded='true'] .ds-burger {
    background-color: transparent;
  }

  #nav-toggle[aria-expanded='true'] .ds-burger::before {
    transform: rotate(45deg);
  }

  #nav-toggle[aria-expanded='true'] .ds-burger::after {
    transform: rotate(-45deg);
  }

  .ds-drawer {
    position: fixed;
    top: 4.875rem;
    right: 0.75rem;
    z-index: 1;
    width: min(calc(100% - 1.5rem), 30rem);
    max-height: calc(100dvh - 5.625rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid color-mix(in srgb, var(--color-brand-100) 82%, transparent);
    border-radius: 1.25rem;
    background-color: color-mix(in srgb, var(--color-surface) 96%, transparent);
    box-shadow: 0 24px 70px -22px rgb(6 27 49 / 0.32);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    backdrop-filter: blur(22px) saturate(1.2);
    opacity: 0;
    transform: translate3d(0, -0.75rem, 0) scale(0.985);
    transform-origin: top right;
    visibility: hidden;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease-out-expo),
      visibility 0ms linear var(--dur-base);
  }

  .ds-drawer[data-open] {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    visibility: visible;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease-out-expo),
      visibility 0ms linear;
  }

  .ds-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .ds-drawer-item {
    opacity: 0;
    transform: translate3d(0, 0.5rem, 0);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .ds-drawer[data-open] .ds-drawer-item {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: calc(70ms + var(--i) * 45ms);
  }

  .ds-drawer-profile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.125rem;
    border-bottom: 1px solid var(--color-brand-50);
  }

  .ds-drawer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .ds-drawer-link {
    display: flex;
    width: 100%;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.75rem 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.02em;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .ds-drawer-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-25);
  }

  .ds-drawer-index {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @media (min-width: 940px) {
    .ds-nav-surface {
      padding-left: 1rem;
    }

    .ds-nav-links,
    .ds-nav-cta {
      display: block;
    }

    .ds-burger-btn,
    .ds-drawer {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .ds-nav-brand span {
      display: none;
    }

    .ds-drawer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
