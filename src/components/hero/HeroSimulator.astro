---
/**
 * Janela de simulação do hero.
 *
 * Combina um painel "editor" com um transcript de aula em inglês, incluindo a
 * correção em tempo real que caracteriza a metodologia da Rise (aulas 100% no
 * idioma). O conteúdo troca conforme o perfil selecionado — tudo já está no
 * HTML e a alternância acontece em CSS (`html[data-audience]`), sem re-render.
 */
---

<div class="ds-sim ds-dark" data-sim>
  <!-- Chrome da janela -->
  <div class="ds-sim-chrome">
    <div class="flex items-center gap-1.5" aria-hidden="true">
      <span class="ds-dot" style="--dot:#ff5f57"></span>
      <span class="ds-dot" style="--dot:#febc2e"></span>
      <span class="ds-dot" style="--dot:#28c840"></span>
    </div>

    <div class="ds-sim-tabs" role="tablist" aria-label="Painéis da simulação">
      <button type="button" role="tab" class="ds-sim-tab" data-sim-tab="editor" aria-selected="true">
        <span data-aud="tech">standup.ts</span>
        <span data-aud="young">now-playing.srt</span>
      </button>
      <button type="button" role="tab" class="ds-sim-tab" data-sim-tab="live" aria-selected="false">
        live-session
      </button>
    </div>

    <span class="ds-sim-status" aria-hidden="true">
      <span class="ds-pulse"></span>
      EN
    </span>
  </div>

  <!-- ── Painel: editor ─────────────────────────────────────────────── -->
  <div class="ds-sim-pane" data-sim-pane="editor" role="tabpanel">
    <div data-aud="tech">
      <pre class="ds-code"><code><span class="ln"> 1</span><span class="c">// daily standup · 09:30 (GMT-3)</span>
<span class="ln"> 2</span><span class="k">const</span> <span class="v">update</span> <span class="p">= &#123;</span>
<span class="ln"> 3</span>  <span class="pr">yesterday</span><span class="p">:</span> <span class="s">'I shipped the auth refactor'</span><span class="p">,</span>
<span class="ln"> 4</span>  <span class="pr">today</span><span class="p">:</span>     <span class="s">'I am pairing with Ana on the API'</span><span class="p">,</span>
<span class="ln"> 5</span>  <span class="pr">blockers</span><span class="p">:</span>  <span class="s">'staging has been down since yesterday'</span><span class="p">,</span>
<span class="ln"> 6</span><span class="p">&#125;;</span>
<span class="ln"> 7</span>
<span class="ln"> 8</span><span class="f">speak</span><span class="p">(</span><span class="v">update</span><span class="p">);</span> <span class="c">// sem traduzir, sem travar</span></code></pre>
    </div>

    <div data-aud="young">
      <pre class="ds-code"><code><span class="ln"> 1</span><span class="c">00:01:12,400 --&gt; 00:01:15,900</span>
<span class="ln"> 2</span>I can<span class="p">'</span>t believe you <span class="hl">pulled that off</span>.
<span class="ln"> 3</span>
<span class="ln"> 4</span><span class="c">00:01:16,100 --&gt; 00:01:19,000</span>
<span class="ln"> 5</span>Honestly? I was <span class="hl">winging it</span> the whole time.
<span class="ln"> 6</span>
<span class="ln"> 7</span><span class="c">// 2 expressões novas salvas no seu deck</span>
<span class="ln"> 8</span><span class="f">review</span><span class="p">(</span><span class="s">'pull off'</span><span class="p">,</span> <span class="s">'wing it'</span><span class="p">);</span></code></pre>
    </div>
  </div>

  <!-- ── Painel: sessão ao vivo ─────────────────────────────────────── -->
  <div class="ds-sim-pane" data-sim-pane="live" role="tabpanel" hidden>
    <ol class="ds-thread">
      <li class="ds-msg ds-msg--coach" style="--i:0">
        <span class="ds-avatar" aria-hidden="true">E</span>
        <div class="ds-bubble">
          <span data-aud="tech">So — what is blocking the release?</span>
          <span data-aud="young">Tell me about the last series you finished.</span>
        </div>
      </li>

      <li class="ds-msg ds-msg--you" style="--i:1">
        <div class="ds-bubble ds-bubble--you">
          <span data-aud="tech">
            The staging env is down <s class="ds-strike">since ontem</s>
          </span>
          <span data-aud="young">
            I finished it in two days, it is so <s class="ds-strike">viciante</s>
          </span>
        </div>
      </li>

      <li class="ds-msg ds-msg--fix" style="--i:2">
        <div class="ds-fix">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          <span data-aud="tech">since <strong>yesterday</strong></span>
          <span data-aud="young"><strong>addictive</strong></span>
        </div>
      </li>

      <li class="ds-msg ds-msg--coach" style="--i:3">
        <span class="ds-avatar" aria-hidden="true">E</span>
        <div class="ds-bubble">Good. Now say the whole sentence again.</div>
      </li>
    </ol>

    <div class="ds-thread-foot">
      <span class="ds-mono text-abyss-ink/70">correção em tempo real</span>
      <span class="ds-mono text-aqua">00:12 / 50:00</span>
    </div>
  </div>
</div>

<style>
  /* ── Moldura ────────────────────────────────────────────────────────── */
  .ds-sim {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, var(--color-abyss) 0%, var(--color-abyss-deep) 100%);
    box-shadow: var(--shadow-hero);
    overflow: hidden;
    /* Reserva a proporção antes do conteúdo pintar — mantém o CLS em zero */
    min-height: 22rem;
  }

  .ds-sim::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  /* Halo de marca no canto superior — dá o "brilho" Stripe sem custo de pintura */
  .ds-sim::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -20%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 58, 253, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  html[data-audience='young'] .ds-sim::after {
    background: radial-gradient(circle, rgba(249, 107, 238, 0.35) 0%, transparent 70%);
  }

  /* ── Chrome ─────────────────────────────────────────────────────────── */
  .ds-sim-chrome {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ds-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--dot);
    opacity: 0.85;
  }

  .ds-sim-tabs {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
  }

  .ds-sim-tab {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(195, 200, 245, 0.7);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .ds-sim-tab:hover {
    color: #fff;
  }

  .ds-sim-tab[aria-selected='true'] {
    background-color: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .ds-sim-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-aqua);
  }

  .ds-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-aqua);
    box-shadow: 0 0 0 0 rgba(69, 209, 255, 0.6);
    animation: ds-pulse 2.4s ease-out infinite;
  }

  @keyframes ds-pulse {
    70% {
      box-shadow: 0 0 0 7px rgba(69, 209, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(69, 209, 255, 0);
    }
  }

  /* ── Painéis ────────────────────────────────────────────────────────── */
  .ds-sim-pane {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 1.25rem 1rem 1.25rem 0.5rem;
  }

  .ds-sim-pane[hidden] {
    display: none;
  }

  /* ── Código ─────────────────────────────────────────────────────────── */
  .ds-code {
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.6rem + 0.35vw, 0.8125rem);
    line-height: 1.85;
    color: #dfe3ff;
    tab-size: 2;
  }

  .ds-code .ln {
    display: inline-block;
    width: 2.25rem;
    padding-right: 0.9rem;
    text-align: right;
    color: rgba(195, 200, 245, 0.35);
    user-select: none;
  }

  .ds-code .c {
    color: #7c86c7;
  }
  .ds-code .k {
    color: var(--color-magenta);
  }
  .ds-code .s {
    color: var(--color-lime);
  }
  .ds-code .pr,
  .ds-code .f {
    color: var(--color-aqua);
  }
  .ds-code .v {
    color: #dfe3ff;
  }
  .ds-code .p {
    color: rgba(195, 200, 245, 0.65);
  }

  .ds-code .hl {
    border-radius: 3px;
    background-color: rgba(249, 107, 238, 0.18);
    box-shadow: inset 0 -1px 0 var(--color-magenta);
    padding: 0 2px;
  }

  /* ── Transcript ─────────────────────────────────────────────────────── */
  .ds-thread {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0 0.5rem;
    list-style: none;
  }

  .ds-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }

  /* A revelação só arranca quando a janela entra na viewport */
  [data-sim][data-played] .ds-msg {
    animation: ds-msg-in 0.5s var(--ease-out-expo) forwards;
    animation-delay: calc(var(--i) * 220ms);
  }

  @keyframes ds-msg-in {
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .ds-msg--you,
  .ds-msg--fix {
    justify-content: flex-end;
  }

  .ds-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--color-brand) 0%, var(--color-aqua) 100%);
    font-size: 0.6875rem;
    font-weight: 700;
    color: #fff;
  }

  .ds-bubble {
    max-width: 82%;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.07);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #eef0ff;
  }

  .ds-bubble--you {
    background-color: rgba(83, 58, 253, 0.28);
    box-shadow: inset 0 0 0 1px rgba(83, 58, 253, 0.5);
  }

  .ds-strike {
    color: rgba(255, 255, 255, 0.5);
    text-decoration-color: var(--color-ruby);
    text-decoration-thickness: 1.5px;
  }

  .ds-fix {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background-color: rgba(180, 244, 97, 0.14);
    box-shadow: inset 0 0 0 1px rgba(180, 244, 97, 0.35);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-lime);
  }

  .ds-fix strong {
    font-weight: 700;
    color: #dff7b4;
  }

  .ds-thread-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding: 0.75rem 0.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(html.no-js) .ds-msg {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-msg {
      opacity: 1;
      transform: none;
    }
    .ds-pulse {
      animation: none;
    }
  }
</style>
