---
interface Props {
  name: 'imersao' | 'trilha' | 'certificacao' | 'idiomas' | 'programas';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<!--
  Ícones animados. Cada um anima só `transform`, `opacity` ou `stroke-dashoffset`
  — nenhuma propriedade que force layout. O movimento é contínuo mas lento, e
  para completamente com `prefers-reduced-motion`.
-->
<span class={`ds-icon ds-icon--${name} ${className}`} aria-hidden="true">
  {
    name === 'imersao' && (
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="20" cy="20" r="7" />
        <circle class="ring ring-1" cx="20" cy="20" r="12" opacity="0.55" />
        <circle class="ring ring-2" cx="20" cy="20" r="17" opacity="0.3" />
      </svg>
    )
  }

  {
    name === 'trilha' && (
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <path class="path" d="M4 30c6 0 6-9 12-9s6-11 12-11h8" stroke-linecap="round" />
        <circle class="dot" cx="4" cy="30" r="2.4" fill="currentColor" stroke="none" />
      </svg>
    )
  }

  {
    name === 'certificacao' && (
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle class="seal" cx="20" cy="16" r="9" />
        <path class="check" d="M16 16.5l3 3 5.5-6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="ribbon" d="M15 24l-2 10 7-4 7 4-2-10" stroke-linejoin="round" />
      </svg>
    )
  }

  {
    name === 'idiomas' && (
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="20" cy="20" r="14" />
        <path class="meridian" d="M20 6c5 4.5 5 23.5 0 28M20 6c-5 4.5-5 23.5 0 28" />
        <path d="M6.6 15.5h26.8M6.6 24.5h26.8" opacity="0.6" />
      </svg>
    )
  }

  {
    name === 'programas' && (
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect class="tile tile-1" x="5" y="5" width="13" height="13" />
        <rect class="tile tile-2" x="22" y="5" width="13" height="13" />
        <rect class="tile tile-3" x="5" y="22" width="13" height="13" />
        <rect class="tile tile-4" x="22" y="22" width="13" height="13" />
      </svg>
    )
  }
</span>

<style>
  .ds-icon {
    display: block;
    width: 2rem;
    height: 2rem;
  }

  .ds-icon svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── Imersão: anéis que pulsam para fora ───────────────────────────── */
  .ring {
    transform-origin: center;
    animation: ds-ring 3.6s var(--ease-inout) infinite;
  }

  .ring-2 {
    animation-delay: 0.6s;
  }

  @keyframes ds-ring {
    0%,
    100% {
      transform: scale(0.9);
      opacity: 0.15;
    }
    50% {
      transform: scale(1.06);
      opacity: 0.6;
    }
  }

  /* ── Trilha: o traço desenha-se e o ponto percorre-o ───────────────── */
  .path {
    stroke-dasharray: 46;
    stroke-dashoffset: 46;
    animation: ds-draw 4.5s var(--ease-inout) infinite;
  }

  @keyframes ds-draw {
    0% {
      stroke-dashoffset: 46;
    }
    45%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .dot {
    animation: ds-dot 4.5s var(--ease-inout) infinite;
  }

  @keyframes ds-dot {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    45%,
    100% {
      transform: translate(32px, -20px);
      opacity: 1;
    }
  }

  /* ── Certificação: o visto desenha-se dentro do selo ───────────────── */
  .check {
    stroke-dasharray: 14;
    stroke-dashoffset: 14;
    animation: ds-check 4s var(--ease-out-expo) infinite;
  }

  @keyframes ds-check {
    0%,
    20% {
      stroke-dashoffset: 14;
    }
    45%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .seal {
    transform-origin: 20px 16px;
    animation: ds-seal 4s var(--ease-inout) infinite;
  }

  @keyframes ds-seal {
    0%,
    100% {
      transform: scale(1);
    }
    48% {
      transform: scale(1.06);
    }
  }

  /* ── Idiomas: o globo roda pelos meridianos ────────────────────────── */
  .meridian {
    transform-origin: 20px 20px;
    animation: ds-globe 7s linear infinite;
  }

  @keyframes ds-globe {
    from {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.1);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ── Programas: os quadrados acendem em sequência ──────────────────── */
  .tile {
    opacity: 0.3;
    transform-origin: center;
    animation: ds-tile 3.2s var(--ease-inout) infinite;
  }

  .tile-2 {
    animation-delay: 0.2s;
  }
  .tile-3 {
    animation-delay: 0.6s;
  }
  .tile-4 {
    animation-delay: 0.4s;
  }

  @keyframes ds-tile {
    0%,
    70%,
    100% {
      opacity: 0.28;
    }
    35% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .path,
    .dot,
    .check,
    .seal,
    .meridian,
    .tile {
      animation: none;
    }

    .path {
      stroke-dashoffset: 0;
    }
    .check {
      stroke-dashoffset: 0;
    }
    .tile {
      opacity: 0.75;
    }
  }
</style>
