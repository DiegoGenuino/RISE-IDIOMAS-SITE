---
interface Props {
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
  /** Aplicado ao <h2> — usado por aria-labelledby nas seções. */
  id?: string;
}

const {
  title,
  lead,
  align = 'left',
  tone = 'light',
  class: className = '',
  id,
} = Astro.props;

const alignment = align === 'center' ? 'items-center text-center mx-auto' : 'items-start';
const titleColor = tone === 'dark' ? 'text-white' : 'text-ink';
const leadColor = tone === 'dark' ? 'text-abyss-ink' : 'text-ink-soft';
---

<div class={`flex max-w-2xl flex-col gap-4 ${alignment} ${className}`} data-split-group>
  <h2 id={id} data-split class={`text-display font-semibold ${titleColor}`} set:html={title} />

  {
    lead && (
      <p data-split-follow class={`text-lead ${leadColor}`}>
        {lead}
      </p>
    )
  }
</div>
