---
import HeroSimulator from '../../components/hero/HeroSimulator.astro';
import Button from '../../components/ui/Button.astro';
import AudienceSwitch from '../../components/ui/AudienceSwitch.astro';
import { audiences, ctaLinks } from '../../data/site';

const [tech, young] = audiences;
---

<section id="inicio" class="ds-hero relative overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24">
  <!-- Campo decorativo: gradiente frio/quente conforme o perfil -->
  <div class="ds-hero-field" aria-hidden="true"></div>

  <div
    class="ds-shell relative grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16"
  >
    <!-- ── Coluna de mensagem ────────────────────────────────────────── -->
    <div class="flex flex-col items-start gap-6">
      <AudienceSwitch size="hero" />

      <h1 class="text-hero text-ink font-semibold" id="audience-region" aria-live="polite">
        <span data-aud="tech">
          O inglês que destrava a sua
          <span class="ds-text-gradient-cool">carreira internacional</span>.
        </span>
        <span data-aud="young">
          O inglês que abre o mundo
          <span class="ds-text-gradient-warm">antes dos 18</span>.
        </span>
      </h1>

      <p class="text-lead text-ink-soft max-w-xl">
        <span data-aud="tech">{tech.sub}</span>
        <span data-aud="young">{young.sub}</span>
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <Button href={ctaLinks.trial} size="lg">
          Agendar aula experimental
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          >
            <path d="M5 12h13M12 5l7 7-7 7"></path>
          </svg>
        </Button>

        <Button variant="secondary" size="lg" data-scroll-to="nivel">
          Descobrir meu nível
          <span class="ds-mono text-[0.6875rem] opacity-60">1 min</span>
        </Button>
      </div>

      <!-- Micro-prova: fatos verificáveis, não números inventados -->
      <ul class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          ['Aulas 100% no idioma', 'Cambridge & Michigan', 'Vila Carrão, São Paulo'].map((item) => (
            <li class="text-ink-muted flex items-center gap-2 text-[0.8125rem]">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-brand"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ── Coluna do simulador ───────────────────────────────────────── -->
    <div class="ds-hero-sim relative">
      <HeroSimulator />
    </div>
  </div>
</section>

<style>
  .ds-hero {
    background:
      radial-gradient(120% 90% at 50% 0%, var(--color-brand-wash) 0%, transparent 55%),
      var(--color-surface);
  }

  /* Campo de gradiente atrás do simulador — pintura única, sem animação */
  .ds-hero-field {
    position: absolute;
    top: -14rem;
    right: -10rem;
    width: 46rem;
    max-width: 90vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 58, 253, 0.16) 0%, transparent 62%);
    filter: blur(28px);
    pointer-events: none;
  }

  :global(html[data-audience='young']) .ds-hero-field {
    background: radial-gradient(circle, rgba(249, 107, 238, 0.18) 0%, transparent 62%);
  }

  /* Entrada escalonada — só transform/opacity */
  .ds-hero > .ds-shell > * > * {
    animation: ds-hero-in 0.75s var(--ease-out-expo) both;
  }

  .ds-hero > .ds-shell > :first-child > *:nth-child(1) {
    animation-delay: 0.05s;
  }
  .ds-hero > .ds-shell > :first-child > *:nth-child(2) {
    animation-delay: 0.12s;
  }
  .ds-hero > .ds-shell > :first-child > *:nth-child(3) {
    animation-delay: 0.19s;
  }
  .ds-hero > .ds-shell > :first-child > *:nth-child(4) {
    animation-delay: 0.26s;
  }
  .ds-hero > .ds-shell > :first-child > *:nth-child(5) {
    animation-delay: 0.33s;
  }

  .ds-hero-sim {
    animation: ds-hero-sim-in 0.9s var(--ease-out-expo) 0.2s both;
  }

  @keyframes ds-hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }

  @keyframes ds-hero-sim-in {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-hero > .ds-shell > * > *,
    .ds-hero-sim {
      animation: none;
    }
  }
</style>
