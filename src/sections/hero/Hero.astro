---
import MeshGradient from '../../components/hero/MeshGradient.astro';
import Button from '../../components/ui/Button.astro';
import AudienceSwitch from '../../components/ui/AudienceSwitch.astro';
import { audiences, ctaLinks } from '../../data/site';

const [tech, young] = audiences;

const trust = ['Aulas 100% no idioma', 'Cambridge & Michigan', 'Vila Carrão, São Paulo'];
---

<section id="inicio" class="ds-hero relative isolate overflow-hidden">
  <MeshGradient />

  <div class="ds-shell ds-grid relative items-center pt-30 pb-16 lg:pt-36 lg:pb-24">
    <!-- ── Mensagem ──────────────────────────────────────────────────── -->
    <div
      class="ds-hero-copy col-span-full flex flex-col items-start gap-6 lg:col-span-7"
      data-split-group
    >
      <AudienceSwitch size="hero" />

      <!--
        Acento em cor sólida, não em background-clip:text: o SplitText anima
        filter:blur() por caractere, e um filtro cria um novo contexto de
        pintura que quebra o recorte do gradiente no texto. Sólido também é
        mais fiel à Stripe, cujos títulos nunca são gradiente.

        O ponto final vive dentro do <span>: fora dele, o SplitText trata-o
        como uma palavra à parte, que poderia cair sozinha numa linha nova.
      -->
      <h1 class="text-hero text-ink font-semibold" id="audience-region" aria-live="polite">
        <span data-aud="tech" data-split="hero">
          O inglês que destrava a sua <span class="text-brand">carreira internacional.</span>
        </span>
        <span data-aud="young" data-split="hero">
          O inglês que abre o mundo <span class="text-ruby">antes dos 18.</span>
        </span>
      </h1>

      <p class="text-lead text-ink-soft max-w-xl" data-split-follow>
        <span data-aud="tech">{tech.sub}</span>
        <span data-aud="young">{young.sub}</span>
      </p>

      <div class="flex flex-wrap items-center gap-3" data-split-follow>
        <Button href={ctaLinks.trial} size="lg">
          Agendar aula experimental
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="ds-arrow"
          >
            <path d="M5 12h13M12 5l7 7-7 7"></path>
          </svg>
        </Button>

        <Button variant="secondary" size="lg" data-scroll-to="nivel">
          Descobrir meu nível
          <span class="ds-mono text-[0.6875rem] opacity-60">1 min</span>
        </Button>
      </div>

      <!-- Micro-prova: fatos verificáveis, não números inventados -->
      <ul class="mt-1 flex flex-wrap items-center gap-x-6 gap-y-2" data-split-follow>
        {
          trust.map((item) => (
            <li class="text-ink-muted flex items-center gap-2 text-[0.8125rem]">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-brand"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ── Objeto ────────────────────────────────────────────────────── -->
    <div class="ds-hero-object col-span-full lg:col-span-5" aria-hidden="true">
      <canvas class="ds-orbit" data-orbit></canvas>
    </div>
  </div>
</section>

<style>
  .ds-hero {
    background: linear-gradient(180deg, var(--color-brand-25) 0%, var(--color-surface) 62%);
  }

  /* Entrada escalonada. Só transform e opacity. */
  .ds-hero-copy > * {
    animation: ds-hero-in var(--dur-slow) var(--ease-card) both;
  }

  .ds-hero-copy > *:nth-child(1) {
    animation-delay: 40ms;
  }
  .ds-hero-copy > *:nth-child(2) {
    animation-delay: 110ms;
  }
  .ds-hero-copy > *:nth-child(3) {
    animation-delay: 180ms;
  }
  .ds-hero-copy > *:nth-child(4) {
    animation-delay: 250ms;
  }
  .ds-hero-copy > *:nth-child(5) {
    animation-delay: 320ms;
  }

  .ds-hero-object {
    position: relative;
    aspect-ratio: 1;
    /* Reserva o espaço antes do canvas medir — CLS em zero. */
    min-height: 22rem;
    animation: ds-hero-sim-in var(--dur-scene) var(--ease-card) 160ms both;
  }

  /* Halo por trás do corpo: dá-lhe volume sem custar mais um frame de canvas */
  .ds-hero-object::before {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-brand) 22%, transparent) 0%,
      transparent 68%
    );
    filter: blur(24px);
  }

  :global(html[data-audience='young']) .ds-hero-object::before {
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-magenta) 24%, transparent) 0%,
      transparent 68%
    );
  }

  .ds-orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Cores lidas pelo script; trocam com o perfil. */
    --orbit-core: 127, 125, 252;
    --orbit-edge: 69, 209, 255;
  }

  :global(html[data-audience='young']) .ds-orbit {
    --orbit-core: 249, 107, 238;
    --orbit-edge: 255, 207, 94;
  }

  @keyframes ds-hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @keyframes ds-hero-sim-in {
    from {
      opacity: 0;
      transform: translate3d(0, 32px, 0) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-hero-copy > *,
    .ds-hero-object {
      animation: none;
    }
  }
</style>
