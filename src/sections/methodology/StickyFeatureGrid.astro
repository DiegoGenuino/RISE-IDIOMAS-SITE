---
import Button from '../../components/ui/Button.astro';
import { pillars } from '../../data/methodology';
import { ctaLinks } from '../../data/site';
---

<section
  id="metodologia"
  class="ds-dark ds-seam-t bg-abyss relative text-white"
  style="--seam-from: var(--color-surface)"
  aria-labelledby="metodologia-titulo"
>
  <!--
    Bloco externo com altura estendida: serve de linha do tempo da animação.
    Em telas < 1024px o bloco volta a `height: auto` e os cartões empilham
    normalmente — sticky de 425vh em telemóvel é hostil e caro.
  -->
  <div class="ds-sticky-block" data-sticky-block>
    <div class="ds-sticky-stage" data-sticky-stage>
      <div class="ds-grid-lines pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      </div>

      <!-- ── Cabeçalho (some quando a camada final entra) ─────────────── -->
      <div class="ds-sticky-head ds-shell" data-sticky-head>
        <div class="flex items-center justify-center gap-3">
          <span class="ds-mono text-aqua">Metodologia</span>
          <span class="bg-abyss-line h-px w-10" aria-hidden="true"></span>
        </div>
        <h2
          id="metodologia-titulo"
          data-split
          class="text-display mt-4 max-w-2xl text-center font-semibold text-white"
        >
          Quatro decisões de ensino que mudam o seu resultado
        </h2>
      </div>

      <!-- ── Camada dos cartões ───────────────────────────────────────── -->
      <div class="ds-pillar-field" data-pillar-field>
        <div class="ds-pillar-grid ds-shell">
          {
            pillars.map((pillar, index) => (
              <article
                class="ds-pillar"
                data-pillar
                style={`--offset:${index % 2 === 0 ? 1 : 1.55}`}
              >
                <div class="flex items-center justify-between">
                  <span class="ds-mono text-aqua">{pillar.index}</span>
                  <span class="ds-pillar-node" aria-hidden="true" />
                </div>

                <h3 class="mt-5 text-lg leading-snug font-semibold text-white">{pillar.title}</h3>

                <p class="text-abyss-ink mt-3 text-sm leading-relaxed">{pillar.description}</p>

                <ul class="border-abyss-line/60 mt-5 flex flex-col gap-1.5 border-t pt-4">
                  {pillar.bullets.map((bullet) => (
                    <li class="text-abyss-ink/80 flex items-center gap-2 font-mono text-[0.6875rem] tracking-wide">
                      <span class="text-brand-soft/60">›</span>
                      {bullet}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Véu que escurece os cartões antes da camada textual entrar -->
      <div class="ds-sticky-scrim" data-sticky-scrim aria-hidden="true"></div>

      <!-- ── Camada textual central ───────────────────────────────────── -->
      <div class="ds-sticky-copy ds-shell" data-sticky-copy>
        <div class="mx-auto flex max-w-xl flex-col items-center gap-6 text-center">
          <span class="ds-mono text-aqua">O foco é você</span>

          <p class="text-title font-semibold text-white">
            Uma jornada mais leve e eficaz, planejada para desenvolver
            <span class="ds-text-gradient-cool">sua confiança e autonomia</span>.
          </p>

          <p class="text-abyss-ink text-sm leading-relaxed">
            Aprendizado prático e direcionado para que você alcance seu nível ideal com clareza e
            segurança.
          </p>

          <div class="flex flex-wrap justify-center gap-3">
            <Button href={ctaLinks.trial} size="lg">Agendar aula experimental</Button>
            <Button variant="onDark" size="lg" data-scroll-to="modalidades">
              Ver modalidades
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══ Mobile / tablet: fluxo normal ═══════════════════════════════════ */
  .ds-sticky-block {
    position: relative;
  }

  .ds-sticky-stage {
    position: relative;
    padding-block: 5rem;
    overflow: hidden;
  }

  .ds-sticky-head {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ds-pillar-field {
    position: relative;
    z-index: 1;
    margin-top: 3rem;
  }

  .ds-pillar-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .ds-pillar-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ds-pillar {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      var(--shadow-float);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .ds-pillar-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-brand);
    box-shadow: 0 0 0 4px rgba(83, 58, 253, 0.25);
  }

  .ds-sticky-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      120% 80% at 50% 50%,
      rgba(16, 18, 53, 0.8) 0%,
      var(--color-abyss-deep) 100%
    );
    opacity: 0;
    pointer-events: none;
  }

  .ds-sticky-copy {
    position: relative;
    z-index: 3;
    margin-top: 3.5rem;
  }

  /* ═══ Desktop: cena fixada e conduzida pelo scroll ════════════════════
     Tudo aqui depende de `data-scene-ready`, que o GSAP só coloca depois de
     assumir a cena. Se o JS falhar, estiver desativado, ou o utilizador pedir
     menos movimento, a seção fica no layout empilhado — que é um estado
     desenhado, não um fallback partido.
     ═════════════════════════════════════════════════════════════════════ */
  @media (min-width: 1024px) {
    .ds-pillar-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      align-items: stretch;
    }

    .ds-sticky-block[data-scene-ready] {
      height: 425vh;
    }

    [data-scene-ready] .ds-sticky-stage {
      position: sticky;
      top: 0;
      display: grid;
      place-items: center;
      height: 100vh;
      padding-block: 0;
    }

    [data-scene-ready] .ds-sticky-head {
      position: absolute;
      top: clamp(5rem, 12vh, 8rem);
      /* Centrado por margem e não por translateX: o GSAP anima `y` neste
         elemento e um transform de layout entraria em conflito com o dele. */
      left: 0;
      right: 0;
      margin-inline: auto;
    }

    [data-scene-ready] .ds-pillar-field {
      margin-top: 0;
      width: 100%;
      /* A cena é promovida a camada própria: o scrub só toca em transform. */
      will-change: transform;
    }

    [data-scene-ready] .ds-pillar {
      min-height: 20rem;
      will-change: transform, opacity;
    }

    [data-scene-ready] .ds-sticky-copy {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: grid;
      place-items: center;
      margin-top: 0;
      opacity: 0;
      pointer-events: none;
      will-change: transform, opacity;
    }

    /* Com a camada textual visível, os CTAs voltam a receber clique */
    .ds-sticky-copy[data-active] {
      pointer-events: auto;
    }
  }
</style>
