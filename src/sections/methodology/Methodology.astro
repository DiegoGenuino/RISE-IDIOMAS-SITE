---
import Button from '../../components/ui/Button.astro';
import { pillars } from '../../data/methodology';
import { ctaLinks } from '../../data/site';

/**
 * Metodologia — abas.
 *
 * Antes eram quatro cartões empilhados com um índice a acompanhar o scroll: o
 * indicador dependia de adivinhar qual cartão estava a ser lido, e errava
 * sempre que dois entravam na faixa ao mesmo tempo. Agora são abas de facto —
 * o passo ativo é o que o utilizador escolheu, e não há nada a adivinhar.
 *
 * Só um painel de cada vez, e só o essencial dentro dele.
 */
---

<section
  id="metodologia"
  class="bg-surface-alt py-20 lg:py-28"
  aria-labelledby="metodologia-titulo"
>
  <div class="ds-shell ds-grid items-start">
    <!-- ── Título e abas ─────────────────────────────────────────────── -->
    <div class="col-span-full lg:col-span-5">
      <div class="ds-reveal flex items-center gap-3">
        <span class="ds-mono text-brand">Metodologia</span>
        <span class="bg-brand-100 h-px w-10" aria-hidden="true"></span>
      </div>

      <h2
        id="metodologia-titulo"
        data-split
        class="text-display text-ink ds-reveal mt-4 max-w-md font-semibold"
      >
        Quatro decisões que mudam o seu resultado
      </h2>

      <div class="ds-tabs ds-reveal" role="tablist" aria-label="Pilares da metodologia">
        <span class="ds-tab-track" aria-hidden="true"></span>
        <span class="ds-tab-thumb" data-tab-thumb aria-hidden="true"></span>
        {
          pillars.map((pillar, index) => (
            <button
              type="button"
              role="tab"
              class="ds-tab"
              data-step={index}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`pilar-${index}`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="ds-tab-index">{pillar.index}</span>
              <span class="ds-tab-label">{pillar.title}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- ── Painéis ───────────────────────────────────────────────────── -->
    <div class="ds-panels ds-reveal col-span-full lg:col-span-7">
      {
        pillars.map((pillar, index) => (
          <div
            id={`pilar-${index}`}
            class="ds-panel"
            data-panel={index}
            data-active={index === 0 ? '' : undefined}
            role="tabpanel"
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <span style="--i:0" class="ds-panel-index">
              {pillar.index}
            </span>
            <h3 style="--i:1" class="text-title text-ink mt-6 max-w-lg font-semibold">
              {pillar.title}
            </h3>
            <p style="--i:2" class="text-ink-soft text-lead mt-5 max-w-xl">
              {pillar.description}
            </p>
          </div>
        ))
      }

      <Button href={ctaLinks.trial} size="lg" class="mt-10">Agendar aula experimental</Button>
    </div>
  </div>
</section>

<style>
  .ds-grid {
    row-gap: 3rem;
  }

  /* ── Abas ───────────────────────────────────────────────────────────── */
  .ds-tabs {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 2.5rem;
  }

  /* Trilho contínuo mais um único indicador que viaja entre os passos —
     em vez de uma barra por aba a crescer no lugar. */
  .ds-tab-track {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 2px;
    background-color: var(--color-brand-100);
  }

  .ds-tab-thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: var(--thumb-h, 0);
    background-color: var(--color-brand);
    transform: translate3d(0, var(--thumb-y, 0), 0);
    transition:
      transform var(--dur-base) var(--ease-card),
      height var(--dur-base) var(--ease-card),
      opacity var(--dur-fast) var(--ease);
    will-change: transform;
  }

  .ds-tabs:not([data-ready]) .ds-tab-thumb {
    opacity: 0;
  }

  .ds-tab {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.875rem;
    padding: 0.9rem 0 0.9rem 1.5rem;
    text-align: left;
    cursor: pointer;
    color: var(--color-ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .ds-tab:hover {
    color: var(--color-ink);
  }

  .ds-tab-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .ds-tab[aria-selected='true'] .ds-tab-index {
    color: var(--color-brand);
  }

  .ds-tab-label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .ds-tab[aria-selected='true'] .ds-tab-label {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── Painéis empilhados na mesma célula ─────────────────────────────── */
  .ds-panels {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ds-panel {
    /* Todos ocupam a mesma célula: a altura é a do maior e a troca não
       empurra o botão que vem a seguir. */
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease),
      visibility 0s linear var(--dur-base);
  }

  .ds-panel > * {
    opacity: 0;
    transform: translate3d(1.25rem, 0, 0);
    transition:
      opacity var(--dur-base) var(--ease-card),
      transform var(--dur-base) var(--ease-card);
  }

  .ds-panels {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: start;
  }

  .ds-panels > :last-child {
    grid-row: 2;
  }

  .ds-panel[data-active] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-fast) var(--ease),
      visibility 0s linear 0s;
  }

  .ds-panel[data-active] > * {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .ds-panel-index {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-brand-100);
  }
</style>
