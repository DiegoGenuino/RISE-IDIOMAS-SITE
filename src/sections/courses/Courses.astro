---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import { courses } from '../../data/courses';
import { ctaLinks } from '../../data/site';

/** Cartões que pertencem a um só perfil são escondidos em CSS pelo seletor. */
function audienceAttr(audiences: readonly string[]): string | undefined {
  return audiences.length === 1 ? audiences[0] : undefined;
}

/**
 * Três dos seis programas declaram um intervalo CEFR no `meta` ("B1 → C2").
 * Quando existe, ele vira uma régua de seis degraus com a faixa coberta acesa —
 * dá para comparar dois programas de relance, sem ler. Os outros (Cambridge ·
 * Michigan, faixas etárias) ficam só com o rótulo: nada é inventado.
 */
const LEVELS = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];

function levelSpan(meta: string): [number, number] | null {
  const match = meta.match(/^([A-C][12])\s*→\s*([A-C][12])$/);
  if (!match) return null;
  const from = LEVELS.indexOf(match[1]);
  const to = LEVELS.indexOf(match[2]);
  return from < 0 || to < 0 ? null : [from, to];
}
---

<section id="modalidades" class="bg-surface py-20 lg:py-28" aria-labelledby="modalidades-titulo">
  <div class="ds-shell flex flex-col gap-12">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading
        title="Uma trilha para cada objetivo"
        lead="Seis programas, do primeiro contato à certificação internacional. O conteúdo abaixo acompanha o perfil que você escolheu no topo."
        class="ds-reveal"
      />

      <Button variant="secondary" href={ctaLinks.trial} class="ds-reveal shrink-0 self-start">
        Não sei qual escolher
      </Button>
    </div>

    <ul class="ds-course-grid" data-spotlight>
      {
        courses.map((course, index) => {
          const span = levelSpan(course.meta);
          return (
            <li
              class="ds-reveal"
              data-aud={audienceAttr(course.audiences)}
              style={`--reveal-i:${index}`}
            >
              <article class="ds-card ds-course group" data-grad={index % 4}>
                <span class="ds-spotlight" aria-hidden="true" />
                <span class="ds-course-wash" aria-hidden="true" />

                <div class="ds-course-body">
                  <header class="ds-course-head">
                    <span class="ds-course-num">{String(index + 1).padStart(2, '0')}</span>
                    <span class="ds-course-meta">{course.meta}</span>
                  </header>

                  <h3 class="ds-course-title">{course.title}</h3>
                  <p class="ds-course-sub">{course.subtitle}</p>
                  <p class="ds-course-desc">{course.description}</p>

                  {span && (
                    <ol class="ds-course-ramp" aria-hidden="true">
                      {LEVELS.map((level, step) => (
                        <li class="ds-course-step" data-on={step >= span[0] && step <= span[1]}>
                          <span class="ds-course-bar" />
                          <span class="ds-course-cefr">{level}</span>
                        </li>
                      ))}
                    </ol>
                  )}

                  <button type="button" class="ds-course-cta" data-open-modal={course.id}>
                    Ver o programa
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      class="ds-arrow"
                    >
                      <path d="M5 12h13M12 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<!-- ── Detalhe de cada modalidade ───────────────────────────────────── -->
{
  courses.map((course) => (
    <dialog
      class="ds-modal"
      id={`curso-${course.id}`}
      aria-labelledby={`curso-${course.id}-titulo`}
    >
      <div class="ds-modal-card">
        <button type="button" class="ds-modal-close" data-close-modal aria-label="Fechar">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>

        <span class="ds-mono text-brand">{course.meta}</span>

        <h3 id={`curso-${course.id}-titulo`} class="text-title text-ink mt-3 font-semibold">
          {course.title}
        </h3>

        <p class="text-brand mt-1 font-semibold">{course.subtitle}</p>

        <p class="text-ink-soft mt-5 text-[0.9375rem] leading-relaxed">{course.detail}</p>

        <ul class="border-brand-soft/70 mt-6 flex flex-col gap-3 border-t pt-6">
          {course.features.map((feature, index) => (
            <li class="text-ink flex items-start gap-3 text-sm">
              <span class="ds-mono text-brand/70 mt-0.5 shrink-0 text-[0.6875rem]">
                {String(index + 1).padStart(2, '0')}
              </span>
              {feature}
            </li>
          ))}
        </ul>

        <Button href={ctaLinks.trial} size="lg" class="mt-8 w-full">
          Agendar aula experimental
        </Button>
      </div>
    </dialog>
  ))
}

<style>
  /* Fio único entre cartões em vez de um vão: a grelha lê-se como uma tabela
     de programas, e não como seis objetos soltos. O fio é desenhado por
     cartão, e não como fundo da grelha — o seletor de perfil esconde dois
     cartões, e um fundo deixaria blocos de cor nas células vazias. */
  .ds-course-grid {
    display: grid;
    gap: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .ds-course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 940px) {
    .ds-course-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ds-course-grid > li {
    display: flex;
  }

  /* Cantos vivos, como na Stripe. O material e o hover continuam a vir de
     .ds-card — aqui só se corrige o raio e o preenchimento. */
  .ds-course {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    border-radius: 0;
    box-shadow: inset 0 0 0 1px var(--color-brand-100);
    overflow: hidden;
  }

  .ds-course::before {
    border-radius: 0;
  }

  @media (hover: hover) {
    .ds-course:hover {
      transform: none;
      /* Sobe acima dos vizinhos para a borda em gradiente não ser cortada
         pelo fio da grelha. */
      z-index: 1;
      box-shadow:
        inset 0 0 0 1px transparent,
        var(--shadow-lg);
    }
  }

  /* Lavado de gradiente a entrar por um canto diferente em cada cartão — a
     mesma família do bento, sem repetir o mesmo enfeite seis vezes. */
  .ds-course-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.55;
    transition: opacity var(--dur-slow) var(--ease-card);
  }

  .ds-course[data-grad='0'] .ds-course-wash {
    background: radial-gradient(
      120% 90% at 100% 0%,
      color-mix(in srgb, var(--color-brand) 9%, transparent),
      transparent 62%
    );
  }
  .ds-course[data-grad='1'] .ds-course-wash {
    background: radial-gradient(
      120% 90% at 0% 0%,
      color-mix(in srgb, var(--color-aqua) 16%, transparent),
      transparent 62%
    );
  }
  .ds-course[data-grad='2'] .ds-course-wash {
    background: radial-gradient(
      120% 90% at 100% 100%,
      color-mix(in srgb, var(--color-magenta) 10%, transparent),
      transparent 62%
    );
  }
  .ds-course[data-grad='3'] .ds-course-wash {
    background: radial-gradient(
      120% 90% at 0% 100%,
      color-mix(in srgb, var(--color-brand-400) 14%, transparent),
      transparent 62%
    );
  }

  @media (hover: hover) {
    .ds-course:hover .ds-course-wash {
      opacity: 1;
    }
  }

  .ds-course-body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem;
  }

  .ds-course-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-brand-100);
  }

  .ds-course-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-300);
  }

  .ds-course-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  .ds-course-title {
    margin-top: 1.25rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .ds-course-sub {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
  }

  .ds-course-desc {
    /* Empurra a régua e a chamada para baixo: as réguas dos três cartões de
       uma linha alinham-se entre si mesmo com descrições de alturas
       diferentes. */
    flex: 1;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  /* ── Régua CEFR ─────────────────────────────────────────────────────── */
  .ds-course-ramp {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .ds-course-step {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .ds-course-bar {
    display: block;
    height: 3px;
    background-color: var(--color-brand-100);
    transition: background-color var(--dur-slow) var(--ease-card);
  }

  .ds-course-step[data-on='true'] .ds-course-bar {
    background-color: var(--color-brand-300);
  }

  @media (hover: hover) {
    .ds-course:hover .ds-course-step[data-on='true'] .ds-course-bar {
      background-color: var(--color-brand);
    }
  }

  .ds-course-cefr {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .ds-course-step[data-on='true'] .ds-course-cefr {
    color: var(--color-brand-800);
  }

  /* ── Chamada ────────────────────────────────────────────────────────── */
  .ds-course-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 1.75rem;
    align-self: flex-start;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }

  /* Área de clique estendida ao cartão inteiro. O alvo continua a ser o
     botão — teclado e leitores de ecrã veem exatamente um controlo. */
  .ds-course-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ds-course-cta:hover {
    color: var(--color-brand-deep);
  }

  /* ── Modal ──────────────────────────────────────────────────────────── */
  .ds-modal {
    max-width: min(34rem, calc(100vw - 2rem));
    width: 100%;
    max-height: min(85vh, 46rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }

  .ds-modal::backdrop {
    background-color: rgba(6, 27, 49, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .ds-modal[open] {
    animation: ds-modal-in 0.35s var(--ease-out-expo);
  }

  .ds-modal[open]::backdrop {
    animation: ds-backdrop-in 0.35s ease;
  }

  @keyframes ds-modal-in {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0) scale(0.98);
    }
  }

  @keyframes ds-backdrop-in {
    from {
      opacity: 0;
    }
  }

  .ds-modal-card {
    position: relative;
    max-height: min(85vh, 46rem);
    overflow-y: auto;
    padding: 2rem;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-hero);
    overscroll-behavior: contain;
  }

  .ds-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-xs);
    color: var(--color-ink-muted);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .ds-modal-close:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-ink);
  }
</style>
