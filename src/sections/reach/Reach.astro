---
import { proofStats } from '../../data/methodology';
import { site } from '../../data/site';

/**
 * "O alcance de um idioma" — adaptação da seção da Stripe em que um objeto
 * animado ocupa o fundo enquanto os números ficam por cima.
 *
 * Substitui a antiga faixa de prova social: leva as mesmas métricas (todas
 * verificáveis — modalidades, idiomas, certificadoras e horário) para um
 * formato com muito mais presença. As abas trocam a cor do feixe por idioma.
 *
 * O objeto é canvas 2D, não three.js: são linhas a partir de um ponto, e a
 * biblioteca custaria ~600 KB para desenhar isso.
 */
const contexts = {
  tech: [
    'Daily meetings',
    'Code review',
    'Entrevista técnica',
    'Contratos internacionais',
    'Apresentação global',
    'Certificação',
  ],
  young: [
    'Intercâmbio',
    'Vestibular',
    'Séries sem legenda',
    'Games e comunidades',
    'Faculdade no exterior',
    'Certificação',
  ],
};

/** Cada idioma tinge o feixe com uma cor da paleta. */
const tints = [
  { label: site.languages[0], rgb: '166, 178, 255' },
  { label: site.languages[1], rgb: '249, 140, 200' },
  { label: site.languages[2], rgb: '120, 216, 255' },
];
---

<section
  id="alcance"
  class="ds-dark ds-seam-t bg-abyss-deep relative overflow-hidden text-white"
  style="--seam-from: var(--color-surface)"
  aria-labelledby="alcance-titulo"
>
  <div class="ds-grain-layer" aria-hidden="true"></div>

  <div class="ds-shell relative">
    <!-- ── Título ────────────────────────────────────────────────────── -->
    <div class="ds-reach-head">
      <h2 id="alcance-titulo" data-split class="text-display max-w-2xl font-semibold text-white">
        O que um idioma abre quando ele é seu de verdade
      </h2>
    </div>

    <!-- ── Métricas ──────────────────────────────────────────────────── -->
    <dl class="ds-reach-stats">
      {
        proofStats.map((stat) => (
          <div class="ds-reach-stat">
            <dt class="sr-only">{stat.label}</dt>
            <dd>
              <span class="ds-reach-value">{stat.value}</span>
              <span class="ds-reach-label">{stat.label}</span>
              <span class="ds-reach-hint">{stat.hint}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- ── Objeto animado ────────────────────────────────────────────── -->
    <div class="ds-reach-stage">
      <canvas class="ds-reach-canvas" data-burst data-burst-tint={tints[0].rgb} aria-hidden="true"
      ></canvas>

      <!-- Contextos: mudam com o perfil escolhido no topo -->
      <div class="ds-reach-contexts">
        {
          (['tech', 'young'] as const).map((audience) => (
            <ul data-aud={audience}>
              {contexts[audience].map((context) => (
                <li class="ds-reach-chip">{context}</li>
              ))}
            </ul>
          ))
        }
      </div>

      <div class="ds-reach-tabs" data-burst-tabs role="tablist" aria-label="Idioma do feixe">
        {
          tints.map((tint, index) => (
            <button
              type="button"
              role="tab"
              class="ds-reach-tab"
              data-burst-tab={tint.rgb}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              {tint.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ds-reach-head {
    padding-block: 5rem 3rem;
    text-align: center;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 940px) {
    .ds-reach-head {
      padding-block: 7rem 4rem;
    }
  }

  /* ── Métricas: linha com fios a separar, como na referência ─────────── */
  .ds-reach-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid color-mix(in srgb, var(--color-abyss-line) 70%, transparent);
  }

  @media (min-width: 940px) {
    .ds-reach-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ds-reach-stat {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .ds-reach-stat + .ds-reach-stat {
    border-left: 1px solid color-mix(in srgb, var(--color-abyss-line) 70%, transparent);
  }

  @media (max-width: 939px) {
    .ds-reach-stat:nth-child(odd) {
      border-left: 0;
    }
    .ds-reach-stat:nth-child(n + 3) {
      border-top: 1px solid color-mix(in srgb, var(--color-abyss-line) 70%, transparent);
    }
  }

  .ds-reach-stat dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ds-reach-value {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .ds-reach-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-abyss-ink);
  }

  .ds-reach-hint {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--color-abyss-ink) 70%, transparent);
  }

  /* ── Palco do objeto ────────────────────────────────────────────────── */
  .ds-reach-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-top: 3rem;
    /* Reserva a altura antes do canvas pintar — CLS em zero. */
    min-height: 34rem;
  }

  .ds-reach-canvas {
    position: absolute;
    inset-inline: -15%;
    bottom: 0;
    top: 2rem;
    width: 130%;
    height: auto;
    pointer-events: none;
  }

  /* O script lê --burst-rgb do canvas; a aba clicada muda o data-attribute e
     é este par de seletores que troca a cor. */
  .ds-reach-canvas[data-burst-tint='166, 178, 255'] {
    --burst-rgb: 166, 178, 255;
  }
  .ds-reach-canvas[data-burst-tint='249, 140, 200'] {
    --burst-rgb: 249, 140, 200;
  }
  .ds-reach-canvas[data-burst-tint='120, 216, 255'] {
    --burst-rgb: 120, 216, 255;
  }

  /* ── Contextos ──────────────────────────────────────────────────────── */
  .ds-reach-contexts {
    position: relative;
    z-index: 1;
  }

  .ds-reach-contexts ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 42rem;
  }

  .ds-reach-chip {
    padding: 0.4rem 0.8rem;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-abyss-line) 80%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-abyss-ink);
  }

  /* ── Abas de idioma ─────────────────────────────────────────────────── */
  .ds-reach-tabs {
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-top: auto;
    margin-bottom: 3.5rem;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-abyss-line) 80%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .ds-reach-tab {
    padding: 0.6rem 1.1rem;
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-abyss-ink);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .ds-reach-tab:hover {
    color: #fff;
  }

  .ds-reach-tab[aria-selected='true'] {
    color: var(--color-abyss-deep);
    background-color: #fff;
  }
</style>
