---
import { Image } from 'astro:assets';
import reachPhoto from '../../assets/images/reach/CTA-bg.jpg';
import { proofStats } from '../../data/methodology';

const languages = [
  {
    id: 'english',
    tab: 'Inglês',
    eyebrow: 'Inglês para a vida real',
    title: 'Fale com o mundo sem ensaiar cada palavra.',
    body: 'Da primeira conversa às grandes oportunidades, você aprende a se expressar com segurança — do seu jeito e no seu ritmo.',
    contexts: [
      'Carreira internacional',
      'Viagens com autonomia',
      'Conversas que fluem',
      'Cambridge e Michigan',
    ],
  },
  {
    id: 'spanish',
    tab: 'Espanhol',
    eyebrow: 'Espanhol para novas conexões',
    title: 'Mais perto de pessoas, culturas e possibilidades.',
    body: 'Um espanhol natural e prático para você circular pela América Latina, criar vínculos e aproveitar cada oportunidade.',
    contexts: [
      'Negócios na América Latina',
      'Viagens sem roteiro',
      'Cultura sem tradução',
      'Comunicação cotidiana',
    ],
  },
] as const;
---

<section
  id="alcance"
  class="ds-reach text-white"
  data-reach
  data-language="english"
  aria-labelledby="reach-title-english"
>
  <Image
    src={reachPhoto}
    alt="Jovem sorrindo ao ar livre em um encontro com amigos"
    class="ds-reach-photo"
    widths={[960, 1440, 1920]}
    sizes="100vw"
    loading="lazy"
    quality={88}
  />
  <div class="ds-reach-shade" aria-hidden="true"></div>

  <div class="ds-reach-content">
    <div class="ds-reach-copy" aria-live="polite">
      {
        languages.map((language, index) => (
          <div
            id={`reach-panel-${language.id}`}
            class="ds-reach-panel"
            data-language-panel={language.id}
            role="tabpanel"
            aria-labelledby={`reach-tab-${language.id}`}
            hidden={index !== 0}
          >
            <p class="ds-reach-eyebrow">{language.eyebrow}</p>
            <h2 id={`reach-title-${language.id}`}>{language.title}</h2>
            <p class="ds-reach-body">{language.body}</p>

            <ul class="ds-reach-contexts" aria-label={`O que você conquista com ${language.tab}`}>
              {language.contexts.map((context) => (
                <li>{context}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <dl class="ds-reach-stats" aria-label="Números da Rise Idiomas">
      {
        proofStats.map((stat) => (
          <div class="ds-reach-stat">
            <dt>{stat.label}</dt>
            <dd>
              <strong>{stat.value}</strong>
              <span>{stat.hint}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="ds-reach-tabs" data-language-tabs role="tablist" aria-label="Escolha o idioma">
      {
        languages.map((language, index) => (
          <button
            type="button"
            role="tab"
            id={`reach-tab-${language.id}`}
            class="ds-reach-tab"
            data-language-tab={language.id}
            aria-controls={`reach-panel-${language.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {language.tab}
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ds-reach {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 100%;
    min-height: max(44rem, 86svh);
    overflow: hidden;
    background: #315f7c;
  }

  .ds-reach-photo,
  .ds-reach-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ds-reach-photo {
    z-index: -3;
    object-fit: cover;
    object-position: 50% 46%;
    transition:
      object-position 900ms var(--ease-card),
      filter 600ms var(--ease);
  }

  .ds-reach-shade {
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgb(7 27 43 / 0.42) 0%,
        rgb(7 27 43 / 0.14) 48%,
        rgb(7 27 43 / 0.58) 100%
      ),
      linear-gradient(90deg, rgb(7 27 43 / 0.2), transparent 58%, rgb(7 27 43 / 0.08));
    transition: background 600ms var(--ease);
  }

  .ds-reach[data-language='spanish'] .ds-reach-photo {
    object-position: 49.4% 46%;
    filter: saturate(1.04) sepia(0.04);
  }

  .ds-reach[data-language='spanish'] .ds-reach-shade {
    background:
      linear-gradient(
        180deg,
        rgb(34 24 22 / 0.38) 0%,
        rgb(23 25 30 / 0.11) 48%,
        rgb(23 22 24 / 0.56) 100%
      ),
      linear-gradient(90deg, rgb(37 30 24 / 0.16), transparent 58%, rgb(37 30 24 / 0.04));
  }

  .ds-reach::before,
  .ds-reach::after {
    position: absolute;
    z-index: 2;
    right: clamp(1.25rem, 4vw, 4.5rem);
    left: clamp(1.25rem, 4vw, 4.5rem);
    height: 1px;
    content: '';
    background: rgb(255 255 255 / 0.42);
    pointer-events: none;
  }

  .ds-reach::before {
    top: clamp(1.25rem, 4vw, 4.5rem);
  }

  .ds-reach::after {
    bottom: clamp(1.25rem, 4vw, 4.5rem);
  }

  .ds-reach-content {
    display: grid;
    width: min(100% - clamp(2.5rem, 8vw, 9rem), 72rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(5.5rem, 10vh, 7.5rem) clamp(4.5rem, 8vh, 6.5rem);
    grid-template-rows: 1fr auto auto;
    align-items: center;
    gap: clamp(1.75rem, 4vh, 3.25rem);
  }

  .ds-reach-copy {
    display: grid;
    align-self: end;
    width: 100%;
  }

  .ds-reach-panel {
    grid-area: 1 / 1;
    width: min(100%, 46rem);
    margin-inline: auto;
    text-align: center;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms var(--ease),
      transform 360ms var(--ease-card);
  }

  .ds-reach-panel[hidden] {
    display: none;
  }

  .ds-reach[data-transitioning] .ds-reach-panel {
    opacity: 0;
    transform: translateY(0.6rem);
  }

  .ds-reach-eyebrow {
    margin-bottom: 1rem;
    font-size: clamp(0.68rem, 0.64rem + 0.2vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.82);
  }

  .ds-reach-panel h2 {
    max-width: 43rem;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.35rem + 3.2vw, 4.4rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
    text-shadow: 0 2px 25px rgb(0 0 0 / 0.18);
  }

  .ds-reach-body {
    max-width: 39rem;
    margin: 1.2rem auto 0;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.88);
    text-wrap: balance;
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.22);
  }

  .ds-reach-contexts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: clamp(1.4rem, 3vh, 2.25rem);
  }

  .ds-reach-contexts li {
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 999px;
    background: rgb(7 27 43 / 0.16);
    font-size: 0.71rem;
    font-weight: 570;
    line-height: 1;
    color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .ds-reach-stats {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid rgb(255 255 255 / 0.42);
  }

  .ds-reach-stat {
    display: grid;
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(0.65rem, 2vw, 1.5rem);
    text-align: center;
    grid-template-rows: auto 1fr;
    gap: 0.3rem;
  }

  .ds-reach-stat + .ds-reach-stat {
    border-left: 1px solid rgb(255 255 255 / 0.34);
  }

  .ds-reach-stat dt {
    order: 2;
    font-size: 0.76rem;
    font-weight: 650;
    color: rgb(255 255 255 / 0.82);
  }

  .ds-reach-stat dd {
    display: contents;
    margin: 0;
  }

  .ds-reach-stat strong {
    order: 1;
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 1.2rem + 1.7vw, 2.8rem);
    font-weight: 570;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .ds-reach-stat span {
    order: 3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.64rem;
    color: rgb(255 255 255 / 0.68);
  }

  .ds-reach-tabs {
    position: relative;
    display: grid;
    justify-self: center;
    grid-template-columns: repeat(2, 1fr);
    padding: 0.25rem;
    border: 1px solid rgb(255 255 255 / 0.44);
    border-radius: 999px;
    background: rgb(7 27 43 / 0.34);
    box-shadow: 0 12px 35px rgb(0 0 0 / 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .ds-reach-tabs::before {
    position: absolute;
    inset: 0.25rem auto 0.25rem 0.25rem;
    width: calc(50% - 0.25rem);
    border-radius: 999px;
    content: '';
    background: #fff;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
    transform: translateX(0);
    transition: transform 420ms var(--ease-card);
  }

  .ds-reach[data-language='spanish'] .ds-reach-tabs::before {
    transform: translateX(100%);
  }

  .ds-reach-tab {
    position: relative;
    z-index: 1;
    min-width: 6.25rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 670;
    color: rgb(255 255 255 / 0.78);
    transition: color 240ms var(--ease);
  }

  .ds-reach-tab[aria-selected='true'] {
    color: #132f42;
  }

  .ds-reach-tab:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .ds-reach {
      min-height: 50rem;
    }

    .ds-reach-photo {
      object-position: 64% center;
    }

    .ds-reach[data-language='spanish'] .ds-reach-photo {
      object-position: 63% center;
    }

    .ds-reach-shade {
      background:
        linear-gradient(
          180deg,
          rgb(7 27 43 / 0.18) 0%,
          rgb(7 27 43 / 0.22) 34%,
          rgb(7 27 43 / 0.82) 78%,
          rgb(7 27 43 / 0.9) 100%
        ),
        linear-gradient(90deg, rgb(7 27 43 / 0.12), transparent);
    }

    .ds-reach[data-language='spanish'] .ds-reach-shade {
      background:
        linear-gradient(
          180deg,
          rgb(34 24 22 / 0.14) 0%,
          rgb(34 24 22 / 0.2) 34%,
          rgb(30 24 23 / 0.8) 78%,
          rgb(30 24 23 / 0.9) 100%
        ),
        linear-gradient(90deg, rgb(34 24 22 / 0.1), transparent);
    }

    .ds-reach-content {
      width: calc(100% - 2.5rem);
      padding-block: 4.5rem 3.7rem;
      gap: 1.5rem;
    }

    .ds-reach-panel h2 {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .ds-reach-body {
      font-size: 0.9rem;
    }

    .ds-reach-contexts {
      gap: 0.35rem;
      margin-top: 1.25rem;
    }

    .ds-reach-contexts li {
      padding: 0.42rem 0.62rem;
      font-size: 0.64rem;
    }

    .ds-reach-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ds-reach-stat {
      padding: 1rem 0.5rem;
    }

    .ds-reach-stat:nth-child(3) {
      border-left: 0;
    }

    .ds-reach-stat:nth-child(n + 3) {
      border-top: 1px solid rgb(255 255 255 / 0.34);
    }

    .ds-reach-stat strong {
      font-size: 1.75rem;
    }

    .ds-reach-stat span {
      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-reach-photo,
    .ds-reach-shade,
    .ds-reach-panel,
    .ds-reach-tabs::before {
      transition: none;
    }
  }
</style>

<script>
  function initReach() {
    const reach = document.querySelector<HTMLElement>('[data-reach]');
    if (!reach || reach.dataset.ready === 'true') return;

    reach.dataset.ready = 'true';
    const tabs = [...reach.querySelectorAll<HTMLButtonElement>('[data-language-tab]')];
    const panels = [...reach.querySelectorAll<HTMLElement>('[data-language-panel]')];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let transitionTimer = 0;

    const selectLanguage = (nextTab: HTMLButtonElement) => {
      const language = nextTab.dataset.languageTab;
      if (!language || nextTab.getAttribute('aria-selected') === 'true') return;

      window.clearTimeout(transitionTimer);
      if (!prefersReducedMotion) reach.dataset.transitioning = '';

      const swap = () => {
        reach.dataset.language = language;

        tabs.forEach((tab) => {
          const selected = tab === nextTab;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.languagePanel !== language;
        });

        const title = reach.querySelector<HTMLElement>(`#reach-title-${language}`);
        if (title) reach.setAttribute('aria-labelledby', title.id);

        requestAnimationFrame(() => delete reach.dataset.transitioning);
      };

      if (prefersReducedMotion) swap();
      else transitionTimer = window.setTimeout(swap, 180);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectLanguage(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const nextTab = tabs[(index + direction + tabs.length) % tabs.length];
        nextTab.focus();
        selectLanguage(nextTab);
      });
    });
  }

  initReach();
  document.addEventListener('astro:page-load', initReach);
</script>
