---
import CentroPreparatorioBgText from '../../assets/icons/centropreparatorio-type-gradient.svg';
import LocationIcon from '../../assets/icons/location-icon.svg';
import Tv from '../../assets/icons/location-tv-element.png';
---

<section id="location" class="z-1 text-center">
  <span
    aria-hidden="true"
    class="absolute -left-40 -z-10 m-auto h-auto w-[230%] translate-y-90 overflow-hidden max-[322px]:translate-y-60 md:-left-80 md:translate-y-100 lg:-left-80 lg:w-[140%]"
  >
    <img
      src={CentroPreparatorioBgText.src}
      class="h-auto w-full py-10 blur-[1.5px] select-none md:blur-[2.5px] lg:blur-[4px] xl:blur-[6px]"
    />
  </span>

  <a
    href="https://maps.app.goo.gl/DaCs2AutkFjybFeV7"
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex w-full justify-center pb-50 max-[322px]:pb-30 lg:pb-30"
  >
    <img
      src={Tv.src}
      alt="location tv"
      class="w-[85%] max-w-xl cursor-pointer transition duration-1200 ease-in-out hover:scale-110 md:w-[60%]"
    />
  </a>

  <span class="flex w-full justify-center">
    <img src={LocationIcon.src} alt="location icon" class="lg:w-[6%] xl:w-[3%]" />
  </span>

  <div class="my-2 text-center">
    <p class="font-bold opacity-60 md:text-xl lg:text-3xl">Vila Carrão, São Paulo - SP</p>
    <p class="text-xs opacity-50 md:text-[0.90rem] lg:text-2xl">
      Segunda à Sexta: 08:00 - 21:00 | Sábado: 8:00 - 13:00
    </p>
  </div>

  <button
    type="button"
    onclick="window.open('//maps.app.goo.gl/DaCs2AutkFjybFeV7', '_blank', 'noopener')"
    class="mt-2 inline-flex h-12.75 min-w-28.5 cursor-pointer items-center justify-center rounded-[40px] bg-white/18 px-8 font-['Poppins',sans-serif] text-sm leading-none font-bold whitespace-nowrap text-[#4242a5] no-underline shadow-[0_0_16.1px_-4px_#4242a5] transition-[background-color,box-shadow,transform] duration-900 ease-in-out hover:-translate-y-0.5 hover:bg-white/32 hover:shadow-[0_0_24px_-2px_#4242a5] focus-visible:shadow-[0_0_24px_-2px_#4242a5] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#4242a5] motion-reduce:transition-none lg:min-w-38.5"
  >
    Direções
  </button>
</section>
