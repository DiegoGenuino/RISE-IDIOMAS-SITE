---
import Button from '../../components/ui/Button.astro';
import { ctaLinks, site } from '../../data/site';
---

<section id="contato" class="ds-dark bg-abyss relative overflow-hidden py-20 text-white lg:py-28">
  <div class="ds-grid-lines pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
  </div>
  <div class="ds-cta-glow pointer-events-none absolute" aria-hidden="true"></div>

  <div
    class="ds-shell relative grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16"
  >
    <!-- Chamada -->
    <div class="ds-reveal flex flex-col items-start gap-6">
      <div class="flex items-center gap-3">
        <span class="ds-mono text-aqua">Próximo passo</span>
        <span class="bg-abyss-line h-px w-10" aria-hidden="true"></span>
      </div>

      <h2 class="text-display max-w-xl font-semibold text-white">
        Preparado para dar um salto na sua carreira?
      </h2>

      <p class="text-lead text-abyss-ink max-w-lg">
        Escolha o idioma e fale direto com a equipe. A conversa começa pelo seu objetivo — não por
        um formulário.
      </p>

      <div class="flex flex-wrap gap-3">
        <Button href={ctaLinks.english} size="lg">Interesse em Inglês</Button>
        <Button href={ctaLinks.spanish} variant="onDark" size="lg">Interesse em Espanhol</Button>
      </div>

      <p class="ds-mono text-abyss-ink/60">
        Também ensinamos {site.languages.join(' · ')}
      </p>
    </div>

    <!-- Cartão de localização -->
    <div class="ds-reveal">
      <div class="ds-place">
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class="ds-mono text-aqua">Unidade</span>
            <p class="mt-2 text-lg font-semibold text-white">{site.address}</p>
          </div>
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="text-brand-soft/70 shrink-0"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>

        <dl class="border-abyss-line/60 mt-6 flex flex-col gap-2.5 border-t pt-5">
          {
            site.hours.map((entry) => (
              <div class="flex items-center justify-between gap-4">
                <dt class="text-abyss-ink text-sm">{entry.days}</dt>
                <dd class="font-mono text-sm font-semibold text-white">{entry.time}</dd>
              </div>
            ))
          }
        </dl>

        <Button href={site.mapsUrl} variant="onDark" class="mt-6 w-full">
          Ver no mapa
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .ds-cta-glow {
    right: -8%;
    bottom: -40%;
    width: 42rem;
    max-width: 85vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 58, 253, 0.4) 0%, transparent 62%);
    filter: blur(40px);
  }

  :global(html[data-audience='young']) .ds-cta-glow {
    background: radial-gradient(circle, rgba(234, 34, 97, 0.32) 0%, transparent 62%);
  }

  .ds-place {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      var(--shadow-float);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
</style>
