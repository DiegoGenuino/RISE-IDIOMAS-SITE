---
import StudentImage1 from '../../assets/images/cta/student-image-1.png';
import StudentImage2 from '../../assets/images/cta/student-image-2.png';
import StudentImage3 from '../../assets/images/cta/student-image-3.png';
import StudentImage4 from '../../assets/images/cta/student-image-4.png';
import StudentImage5 from '../../assets/images/cta/student-image-5.png';
import StudentImage6 from '../../assets/images/cta/student-image-6.png';

import LeftVector from '../../assets/icons/cta-vectors/left-vector.svg';
import RightVector from '../../assets/icons/cta-vectors/right-vector.svg';
interface Student {
  src: string;
  pos: string;
}

const students: Student[] = [
  { src: StudentImage1.src, pos: 'left-[6.67%]   top-[5.23%]' },
  { src: StudentImage2.src, pos: 'left-[20.83%]  top-[37.05%]' },
  { src: StudentImage3.src, pos: 'left-[4.44%]   top-[54.55%]' },
  { src: StudentImage4.src, pos: 'right-[13.54%] top-[5.23%]' },
  { src: StudentImage5.src, pos: 'right-[-3.61%] top-[23.18%]' },
  { src: StudentImage6.src, pos: 'right-[6.39%]  top-[64.55%]' },
];

const BG_LEFT = LeftVector.src;
const BG_RIGHT = RightVector.src;
---

<section
  id="cta"
  class="relative isolate z-1 flex min-h-[clamp(320px,44vw,440px)] flex-col items-center justify-center gap-7 overflow-hidden px-6 py-12 sm:px-8 sm:py-16 lg:min-h-110 lg:gap-0 lg:py-20"
>
  <!-- Decorative background blobs (below everything) -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 min-[300px]:blur-[4px] sm:blur-[6px]"
    style="mask-image: linear-gradient(to bottom, black 0%, black 40%, rgba(0,0,0,0.8) 60%, rgba(0,0,0,0.4) 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 40%, rgba(0,0,0,0.8) 60%, rgba(0,0,0,0.4) 80%, transparent 100%)"
    aria-hidden="true"
  >
    <!-- Left blob — rotated -->
    <div
      class="absolute top-11.25 -left-14 aspect-544/496 w-[clamp(400px,68vw,40vw)] rotate-130 opacity-55 min-[300px]:-translate-x-30 sm:-translate-x-30 sm:rotate-120 lg:translate-y-12 lg:opacity-100 xl:translate-x-0"
    >
      <img
        src={BG_LEFT}
        alt=""
        width="294"
        height="458"
        class="block h-full w-full object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Right blob — clamp() on `right` can't be expressed in Tailwind, so one inline style  -->
    <div
      class="absolute top-3.75 aspect-455/484 w-[clamp(380px,90vw,40vw)] rotate-430 opacity-55 min-[300px]:translate-x-57 min-[300px]:rotate-110 sm:translate-x-10 sm:rotate-70 lg:opacity-100 xl:-translate-x-20"
      style="right: clamp(-143px, -10vw, -56px)"
    >
      <img
        src={BG_RIGHT}
        alt=""
        width="455"
        height="484"
        class="block h-full w-full object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <!-- Floating student photos — desktop only  -->
  <ul
    class="pointer-events-none absolute inset-0 m-0 hidden list-none p-0 xl:block"
    aria-hidden="true"
  >
    {
      students.map((s) => (
        <li
          class={`absolute h-[clamp(100px,10vw,144px)] w-[clamp(100px,10vw,144px)] overflow-hidden rounded-[100px] bg-[rgba(96,96,195,0.4)] shadow-[0_0_8.2px_0_#4444b2] md:rounded-[50px] ${s.pos}`}
        >
          <img
            src={s.src}
            alt=""
            width="144"
            height="144"
            class="h-full w-full object-cover object-top"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))
    }
  </ul>

  <!-- Primary content -->
  <div class="relative z-10 flex max-w-xl flex-col items-center gap-5 text-center">
    <h2
      class="m-0 font-['Poppins',sans-serif] text-[clamp(1.75rem,5vw,3rem)] leading-[1.3] font-bold text-[#4242a5]"
    >
      Preparado para dar um salto na sua carreira ?
    </h2>

    <a
      href="#contato"
      class="inline-flex h-12.75 min-w-38.5 items-center justify-center rounded-[40px] bg-white/18 px-8 font-['Poppins',sans-serif] text-sm leading-none font-bold whitespace-nowrap text-[#4242a5] no-underline shadow-[0_0_16.1px_-4px_#4242a5] transition-[background-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:bg-white/32 hover:shadow-[0_0_24px_-2px_#4242a5] focus-visible:shadow-[0_0_24px_-2px_#4242a5] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#4242a5] motion-reduce:transition-none"
    >
      Fale conosco
    </a>
  </div>

  <!-- Photo strip — mobile / tablet only -->
  <ul
    class="m-0 flex list-none flex-nowrap justify-center p-0 lg:mt-10 xl:hidden"
    aria-hidden="true"
  >
    {
      students.slice(0, 4).map((s, i) => (
        <li
          class:list={[
            'h-[clamp(30px,9vw,44px)] w-[clamp(30px,9vw,44px)] shrink-0',
            'overflow-hidden rounded-[180px]',
            'bg-[#4242a5cc] shadow-[0_0_6px_0_rgba(68,68,178,0.5)] transition-colors duration-600 ease-in-out hover:bg-[#4242a5]',
            i > 0 && '-ml-4',
          ]}
        >
          <img
            src={s.src}
            alt=""
            width="80"
            height="80"
            class="h-full w-full object-cover object-top"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))
    }
  </ul>
</section>
