---
import { proofStats } from '../../data/methodology';

/**
 * Faixa de prova social.
 *
 * ⚠️ O briefing pede logótipos de empresas onde os alunos atuam. A branch
 * `master` não contém nenhuma lista de empresas parceiras nem autorização de
 * uso de marca, por isso a faixa foi construída apenas com factos verificáveis
 * (modalidades, idiomas, certificadoras, horário) e com os contextos de uso já
 * descritos nas modalidades. Para adicionar logótipos reais, preencher o array
 * `partnerLogos` abaixo — a grelha já está preparada.
 */
const partnerLogos: { name: string; src: string }[] = [];

const contexts = [
  'Daily meetings',
  'Code review',
  'Entrevista técnica',
  'Contratos internacionais',
  'Intercâmbio',
  'Certificação',
];
---

<section
  class="border-brand-soft/60 bg-surface-alt border-y py-10 lg:py-12"
  aria-label="Prova social"
>
  <div class="ds-shell flex flex-col gap-8">
    <!-- Contextos de uso -->
    <div class="ds-reveal flex flex-col items-center gap-4 text-center">
      <p class="ds-mono text-ink-muted">Onde nossos alunos usam o idioma</p>
      <ul class="flex flex-wrap justify-center gap-2">
        {
          contexts.map((context) => (
            <li class="text-ink-soft ring-brand-soft/70 rounded-sm bg-white px-3 py-1.5 text-[0.8125rem] font-medium shadow-xs ring-1 ring-inset">
              {context}
            </li>
          ))
        }
      </ul>
    </div>

    {
      partnerLogos.length > 0 && (
        <ul class="ds-reveal flex flex-wrap items-center justify-center gap-x-10 gap-y-6 opacity-60 grayscale">
          {partnerLogos.map((logo) => (
            <li>
              <img src={logo.src} alt={logo.name} height="24" class="h-6 w-auto" loading="lazy" />
            </li>
          ))}
        </ul>
      )
    }

    <!-- Métricas -->
    <dl
      class="ds-reveal bg-brand-soft/70 grid grid-cols-2 gap-px overflow-hidden rounded-lg md:grid-cols-4"
    >
      {
        proofStats.map((stat) => (
          <div class="bg-surface-alt flex flex-col gap-1 p-5">
            <dt class="sr-only">{stat.label}</dt>
            <dd class="flex items-baseline gap-2">
              <span class="text-brand font-mono text-2xl font-semibold tracking-tight">
                {stat.value}
              </span>
              <span class="text-ink text-sm font-semibold">{stat.label}</span>
            </dd>
            <p class="text-ink-muted text-[0.8125rem]">{stat.hint}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>
