---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { faq } from '../../data/faq';
---

<section id="faq" class="bg-surface py-20 lg:py-28" aria-labelledby="faq-titulo">
  <div class="ds-shell ds-grid items-start">
    <!-- ── Coluna fixa ───────────────────────────────────────────────── -->
    <div class="ds-faq-aside col-span-full lg:col-span-4">
      <SectionHeading
        title="Perguntas frequentes"
        lead="Se a sua pergunta não estiver aqui, a equipe responde no WhatsApp."
        class="ds-reveal"
        id="faq-titulo"
      />

    </div>

    <!-- ── Perguntas ─────────────────────────────────────────────────── -->
    <ul class="ds-reveal col-span-full flex flex-col lg:col-span-8">
      {
        faq.map((item, index) => (
          <li>
            <details class="ds-faq" name="faq" open={index === 0}>
              <summary class="ds-faq-summary">
                <span class="ds-faq-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="ds-faq-q">{item.question}</span>
                <span class="ds-faq-icon" aria-hidden="true" />
              </summary>
              <div class="ds-faq-body">
                <p class="ds-faq-a">{item.answer}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ds-grid {
    row-gap: 3rem;
  }

  @media (min-width: 1024px) {
    .ds-faq-aside {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }

  /* ── Item ───────────────────────────────────────────────────────────── */
  .ds-faq {
    position: relative;
    border-bottom: 1px solid var(--color-brand-100);
    transition: background-color var(--dur-base) var(--ease);
  }

  /* Barra de acento à esquerda do item aberto — cresce em vez de aparecer */
  .ds-faq::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1.25rem;
    width: 2px;
    background: linear-gradient(180deg, var(--color-brand-400), var(--color-brand));
    transform: scaleY(0);
    transform-origin: center top;
    transition: transform var(--dur-base) var(--ease-card);
  }

  .ds-faq[open]::before {
    transform: scaleY(1);
  }

  .ds-faq-summary {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 1.375rem;
    cursor: pointer;
    list-style: none;
  }

  .ds-faq-summary::-webkit-details-marker {
    display: none;
  }

  .ds-faq-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .ds-faq[open] .ds-faq-num {
    color: var(--color-brand);
  }

  .ds-faq-q {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease);
  }

  .ds-faq-summary:hover .ds-faq-q {
    color: var(--color-brand);
  }

  .ds-faq-a {
    grid-column: 2;
    max-width: 42rem;
    margin-left: 3rem;
    padding-bottom: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  /* Sinal de +/− desenhado em CSS: anima só com transform */
  .ds-faq-icon {
    position: relative;
    align-self: center;
    width: 14px;
    height: 14px;
  }

  .ds-faq-icon::before,
  .ds-faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    border-radius: 2px;
    background-color: var(--color-brand);
    transform: translateY(-50%);
    transition: transform var(--dur-base) var(--ease-card);
  }

  .ds-faq-icon::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .ds-faq[open] .ds-faq-icon::after {
    transform: translateY(-50%) rotate(0deg);
  }

  /* Abertura fluida onde `interpolate-size` existe */
  @supports (interpolate-size: allow-keywords) {
    .ds-faq::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size var(--dur-base) var(--ease-card),
        content-visibility var(--dur-base) allow-discrete,
        opacity var(--dur-fast) var(--ease);
    }

    .ds-faq[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }
</style>
