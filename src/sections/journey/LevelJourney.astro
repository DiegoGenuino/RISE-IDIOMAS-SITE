---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { journey } from '../../data/journey';

/**
 * Trilha A1 → C2 — escada vertical.
 *
 * O scroll horizontal prendia a página durante quatro viewports para mostrar
 * seis painéis que cabem numa lista. Aqui é uma escada: uma linha por nível,
 * separadas por fios, com um degrau que cresce à esquerda. Lê-se de uma vez,
 * funciona igual no telemóvel e não precisa de GSAP nenhum.
 */
---

<section id="trilha" class="bg-surface-alt py-20 lg:py-28" aria-labelledby="trilha-titulo">
  <div class="ds-shell flex flex-col gap-12">
    <SectionHeading
      eyebrow="Trilha"
      title="Do primeiro <em>hello</em> à proficiência certificada"
      lead="A escala CEFR descreve o que você consegue fazer em cada nível. As horas são a referência pública do Cambridge Assessment — não uma promessa de prazo."
      class="ds-reveal"
      id="trilha-titulo"
    />

    <ol class="ds-ladder">
      {
        journey.map((stage, index) => (
          <li class="ds-rung ds-reveal" style={`--reveal-i:${index}; --step:${index}`}>
            <span class="ds-rung-bar" aria-hidden="true">
              <span class="ds-rung-fill" />
            </span>

            <span class="ds-rung-level">{stage.level}</span>

            <div class="ds-rung-main">
              <h3 class="ds-rung-name">{stage.name}</h3>
              <p class="ds-rung-can">{stage.can}</p>

              <ul class="ds-rung-marks">
                {stage.milestones.map((milestone) => (
                  <li>{milestone}</li>
                ))}
              </ul>
            </div>

            <div class="ds-rung-meta">
              <span class="ds-mono text-ink-muted">{stage.hours}</span>
              <button type="button" class="ds-rung-course" data-scroll-to="modalidades">
                {stage.courseLabel}
              </button>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ds-ladder {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-brand-100);
    list-style: none;
  }

  /* Uma linha por nível. O degrau à esquerda cresce com o índice — a escada
     lê-se de relance, sem precisar de comparar números. */
  .ds-rung {
    display: grid;
    grid-template-columns: 3px auto 1fr;
    align-items: start;
    gap: 1rem 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-brand-100);
    transition: background-color var(--dur-base) var(--ease);
  }

  @media (min-width: 940px) {
    .ds-rung {
      grid-template-columns: 3px 5rem minmax(0, 1fr) 14rem;
      gap: 2rem;
      padding: 2rem 0;
    }
  }

  @media (hover: hover) {
    .ds-rung:hover {
      background-color: color-mix(in srgb, var(--color-brand-25) 70%, transparent);
    }
  }

  /* ── Degrau ─────────────────────────────────────────────────────────── */
  .ds-rung-bar {
    align-self: stretch;
    display: block;
    width: 3px;
    background-color: var(--color-brand-100);
  }

  .ds-rung-fill {
    display: block;
    width: 100%;
    /* Do A1 ao C2: 30% de altura no primeiro degrau, 100% no último. */
    height: calc(30% + var(--step) * 14%);
    background: linear-gradient(180deg, var(--color-brand-400), var(--color-brand));
  }

  .ds-rung-level {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-brand);
    line-height: 1.1;
  }

  /* ── Conteúdo ───────────────────────────────────────────────────────── */
  .ds-rung-name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .ds-rung-can {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .ds-rung-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin-top: 0.875rem;
    list-style: none;
  }

  .ds-rung-marks li {
    position: relative;
    padding-left: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .ds-rung-marks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    background-color: var(--color-brand-300);
  }

  /* ── Metadados ──────────────────────────────────────────────────────── */
  .ds-rung-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    grid-column: 2 / -1;
  }

  @media (min-width: 940px) {
    .ds-rung-meta {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.625rem;
      text-align: right;
    }
  }

  .ds-rung-course {
    padding: 0.3rem 0.7rem;
    background-color: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-brand-100);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-800);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      box-shadow var(--dur-micro) var(--ease);
  }

  .ds-rung-course:hover {
    color: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand-300);
  }
</style>
