---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { getBlogList } from '../../lib/sanity.blog';

const youtubeChannelUrl = 'https://www.youtube.com/@rise.idiomas/';
const youtubeFeedUrl =
  'https://www.youtube.com/feeds/videos.xml?channel_id=UCduXA0CEoMWIDojyi5kH0aw';
const youtubeFallback = {
  title: '3 dias de cultura e idiomas I Okinawa Festival 2026',
  url: 'https://www.youtube.com/watch?v=-ITQY8SlrgI',
  thumbnail: 'https://i2.ytimg.com/vi/-ITQY8SlrgI/hqdefault.jpg',
  publishedAt: '2026-09-04T18:10:48+00:00',
};

function decodeXml(value: string): string {
  return value
    .replaceAll('&amp;', '&')
    .replaceAll('&quot;', '"')
    .replaceAll('&#39;', "'")
    .replaceAll('&lt;', '<')
    .replaceAll('&gt;', '>');
}

let latestVideo = youtubeFallback;

try {
  const response = await fetch(youtubeFeedUrl, { signal: AbortSignal.timeout(3500) });

  if (response.ok) {
    const xml = await response.text();
    const entry = xml.match(/<entry>([\s\S]*?)<\/entry>/)?.[1];
    const title = entry?.match(/<title>([\s\S]*?)<\/title>/)?.[1];
    const url = entry?.match(/<link rel="alternate" href="([^"]+)"/)?.[1];
    const thumbnail = entry?.match(/<media:thumbnail url="([^"]+)"/)?.[1];
    const publishedAt = entry?.match(/<published>([^<]+)<\/published>/)?.[1];

    if (title && url && thumbnail && publishedAt) {
      latestVideo = {
        title: decodeXml(title),
        url: decodeXml(url),
        thumbnail: decodeXml(thumbnail),
        publishedAt,
      };
    }
  }
} catch {
  // The verified fallback keeps the teaser useful if YouTube is unavailable at build time.
}

const latestVideoDate = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(latestVideo.publishedAt));

/**
 * Últimos posts do blog.
 *
 * A home é pré-renderizada, portanto estes posts são resolvidos no build — o
 * que é aceitável para uma página de marketing, que é reconstruída a cada
 * deploy. Se o Sanity falhar ou não houver posts, a seção simplesmente não
 * renderiza: o build nunca quebra por causa do CMS.
 */
let posts: Awaited<ReturnType<typeof getBlogList>>['posts'] = [];

try {
  const result = await getBlogList();
  if (!result.errorMessage) posts = result.posts.slice(0, 3);
} catch {
  posts = [];
}
---

{
  (
    <section id="blog" class="bg-surface-alt py-20 lg:py-28" aria-labelledby="blog-titulo">
      <div class="ds-shell flex flex-col gap-12">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <SectionHeading
            title="Do outro lado da aula"
            lead="Vocabulário, cultura e método — ideias da Rise para ler, assistir e levar com você."
            class="ds-reveal"
            id="blog-titulo"
          />

          <div class="ds-reveal flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href="/blog" class="group text-brand shrink-0 text-sm font-semibold">
              Ver todos os posts
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="ds-arrow ml-1 inline-block align-middle"
              >
                <path d="M5 12h13M12 5l7 7-7 7" />
              </svg>
            </a>

            <a
              href={youtubeChannelUrl}
              target="_blank"
              rel="noreferrer"
              class="ds-channel-link group shrink-0 text-sm font-semibold"
            >
              Canal no YouTube
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </div>
        </div>

        <ul class="ds-teaser-grid" data-spotlight>
          <li class="ds-reveal" style="--reveal-i:0">
            <a
              href={latestVideo.url}
              target="_blank"
              rel="noreferrer"
              class="ds-post ds-video-card ds-card group"
              aria-label={`Assistir no YouTube: ${latestVideo.title}`}
            >
              <span class="ds-spotlight" aria-hidden="true" />

              <span class="ds-post-cover">
                <img
                  src={latestVideo.thumbnail}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="360"
                />
                <span class="ds-video-chip">Último vídeo</span>
                <span class="ds-video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="m9.25 7.3 7.5 4.7-7.5 4.7V7.3Z" />
                  </svg>
                </span>
              </span>

              <span class="ds-post-body">
                <span class="ds-post-meta">
                  <span class="ds-post-kind ds-post-kind--video">YouTube</span>
                  <span class="ds-post-date">{latestVideoDate}</span>
                </span>

                <span class="ds-post-title">{latestVideo.title}</span>

                <span class="ds-post-copy line-clamp-3">
                  Cultura, idiomas e educação em movimento com a equipe da Rise.
                </span>

                <span class="ds-post-footer">
                  <span class="ds-post-reading">Assistir agora</span>
                  <span class="ds-post-action" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none">
                      <path d="M4 12 12 4M6 4h6v6" />
                    </svg>
                  </span>
                </span>
              </span>
            </a>
          </li>

          {posts.map((post, index) => (
            <li class="ds-reveal" style={`--reveal-i:${index + 1}`}>
              <a href={`/blog/${post.slug}`} class="ds-post ds-card group">
                <span class="ds-spotlight" aria-hidden="true" />

                {post.image?.url && (
                  <span class="ds-post-cover">
                    <img
                      src={post.image.url}
                      alt={post.image.alt || ''}
                      loading="lazy"
                      decoding="async"
                      width="480"
                      height="270"
                    />
                  </span>
                )}

                {!post.image?.url && (
                  <span class="ds-post-cover ds-post-cover--fallback" aria-hidden="true">
                    <span class="ds-cover-orbit" />
                  </span>
                )}

                <span class="ds-post-body">
                  <span class="ds-post-meta">
                    <span class="ds-post-kind">{post.category}</span>
                    <span class="ds-post-date">{post.publishDateLabel}</span>
                  </span>

                  <span class="ds-post-title">{post.title}</span>

                  {post.description && (
                    <span class="ds-post-copy line-clamp-3">{post.description}</span>
                  )}

                  <span class="ds-post-footer">
                    <span class="ds-post-reading">{post.readingTimeMinutes} min de leitura</span>
                    <span class="ds-post-action" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none">
                        <path d="M4 12 12 4M6 4h6v6" />
                      </svg>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .ds-post.ds-card {
    --post-accent: var(--color-brand);
    --post-accent-end: var(--color-aqua);
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--color-surface) 96%, var(--color-brand-25));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-brand-100) 68%, var(--color-neutral-100)),
      0 5px 18px -14px rgb(6 27 49 / 0.35);
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      box-shadow var(--dur-base) var(--ease-out-expo);
  }

  .ds-post.ds-card::after {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    height: 2px;
    background: linear-gradient(90deg, var(--post-accent), var(--post-accent-end));
    content: '';
    opacity: 0.78;
    transform: scaleX(0.34);
    transform-origin: left;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-slow) var(--ease-out-expo);
  }

  .ds-video-card.ds-card {
    --post-accent: var(--color-ruby);
    --post-accent-end: var(--color-magenta);
  }

  .ds-teaser-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  .ds-channel-link {
    color: #d81948;
  }

  .ds-channel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .ds-channel-link svg {
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  .ds-channel-link:hover svg {
    transform: translate3d(2px, -2px, 0);
  }

  .ds-post-cover {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 16 / 9;
    margin: 0.5rem 0.5rem 0;
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: var(--color-brand-25);
    box-shadow: inset 0 0 0 1px rgb(6 27 49 / 0.05);
  }

  .ds-post-cover::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgb(6 27 49 / 0.16));
    content: '';
    pointer-events: none;
  }

  .ds-post-cover--fallback {
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        circle at 50% 50%,
        transparent 0 2px,
        var(--color-brand) 2.5px 3.5px,
        transparent 4px
      ),
      radial-gradient(
        circle,
        color-mix(in srgb, var(--color-brand) 20%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(145deg, var(--color-brand-25), var(--color-surface));
    background-size:
      auto,
      18px 18px,
      auto;
  }

  .ds-cover-orbit {
    position: relative;
    width: 4.25rem;
    height: 4.25rem;
    border: 1px solid color-mix(in srgb, var(--color-brand) 26%, transparent);
    border-radius: 50%;
  }

  .ds-cover-orbit::before,
  .ds-cover-orbit::after {
    position: absolute;
    content: '';
  }

  .ds-cover-orbit::before {
    inset: 0.55rem;
    border: 1px dashed color-mix(in srgb, var(--color-brand) 42%, transparent);
    border-radius: 50%;
  }

  .ds-cover-orbit::after {
    top: 50%;
    left: -0.1875rem;
    width: 0.375rem;
    height: 0.375rem;
    background-color: var(--color-brand);
    box-shadow: 4.25rem 0 0 var(--color-aqua);
    transform: translateY(-50%) rotate(45deg);
  }

  .ds-video-chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3125rem 0.5rem;
    z-index: 2;
    background-color: rgb(6 27 49 / 0.84);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .ds-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    background-color: #e21b4d;
    box-shadow:
      0 10px 28px -10px rgb(6 27 49 / 0.5),
      inset 0 0 0 1px rgb(255 255 255 / 0.24);
    color: #fff;
    transform: translate(-50%, -50%);
    transition:
      background-color var(--dur-micro) var(--ease),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .ds-video-play svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .ds-post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-card);
  }

  @media (hover: hover) {
    .ds-post.ds-card:hover {
      transform: translate3d(0, -4px, 0);
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--post-accent) 22%, var(--color-neutral-100)),
        0 18px 42px -22px rgb(6 27 49 / 0.42);
    }

    .ds-post.ds-card:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .ds-post:hover .ds-post-cover img {
      transform: scale(1.045);
    }

    .ds-video-card:hover .ds-video-play {
      background-color: #c81040;
      transform: translate(-50%, -50%) scale(1.08);
    }

    .ds-post:hover .ds-post-title {
      color: color-mix(in srgb, var(--post-accent) 78%, var(--color-ink));
    }

    .ds-post:hover .ds-post-action {
      background-color: var(--post-accent);
      box-shadow: inset 0 0 0 1px var(--post-accent);
      color: #fff;
      transform: translate3d(2px, -2px, 0);
    }
  }

  .ds-post-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--post-accent) 10%, transparent) 0 1px,
      transparent 1px
    );
    background-position: calc(100% + 4px) calc(100% + 4px);
    background-size: 22px 22px;
  }

  .ds-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ds-post-kind {
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-brand-25);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-brand) 12%, transparent);
    color: var(--color-brand-strong);
    font-size: 0.6875rem;
    font-weight: 650;
    line-height: 1;
  }

  .ds-post-kind--video {
    background-color: #fff0f4;
    box-shadow: inset 0 0 0 1px rgb(216 25 72 / 0.14);
    color: #c81040;
  }

  .ds-post-date,
  .ds-post-reading {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.015em;
  }

  .ds-post-date {
    color: var(--color-ink-muted);
  }

  .ds-post-title {
    display: block;
    margin-top: 1rem;
    color: var(--color-ink);
    font-size: clamp(1.05rem, 1vw + 0.65rem, 1.25rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
    transition: color var(--dur-fast) var(--ease);
  }

  .ds-post-copy {
    display: block;
    margin-top: 0.65rem;
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .ds-post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .ds-post-reading {
    color: var(--color-ink-muted);
  }

  .ds-post-action {
    display: grid;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    place-items: center;
    background-color: color-mix(in srgb, var(--post-accent) 7%, var(--color-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--post-accent) 16%, transparent);
    color: var(--post-accent);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .ds-post-action svg {
    width: 0.875rem;
    height: 0.875rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ds-post:focus-visible {
    outline: 2px solid var(--post-accent);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .ds-teaser-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .ds-teaser-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-post.ds-card,
    .ds-post.ds-card::after,
    .ds-post-cover img,
    .ds-video-play,
    .ds-post-action {
      transition: none;
    }
  }
</style>
