---
import NewsletterForm from '../../components/newsletter/NewsletterForm.astro';
import { WHATSAPP_PHONE, site, socialLinks, whatsappLink } from '../../data/site';

/**
 * Rodapé.
 *
 * Três coisas o separam de um rodapé genérico:
 *
 * 1. A grelha é desenhada. Fios verticais entre as colunas e horizontais entre
 *    as faixas — o rodapé lê-se como um plano, e não como quatro listas soltas
 *    empilhadas num fundo escuro.
 * 2. O estado da escola é ao vivo. O horário já estava em `site.hours`; aqui
 *    ele é comparado com a hora de São Paulo e vira "aberto agora" ou o
 *    próximo horário de abertura. É informação, não enfeite.
 * 3. A assinatura está aparada pelo fim da página. A palavra sangra de margem
 *    a margem e é cortada em baixo: ancora o scroll em vez de flutuar num vão.
 */
const currentYear = new Date().getFullYear();

/** Número em formato legível, a partir da mesma constante que gera os links. */
const phoneDisplay = WHATSAPP_PHONE.replace(/^55(\d{2})(\d{5})(\d{4})$/, '+55 ($1) $2-$3');

const columns = [
  {
    title: 'Programas',
    links: [
      { label: 'Executivo', href: '/#modalidades' },
      { label: 'Acadêmico', href: '/#modalidades' },
      { label: 'Jurídico', href: '/#modalidades' },
      { label: 'Preparatórios', href: '/#modalidades' },
      { label: 'Teens & Kids', href: '/#modalidades' },
    ],
  },
  {
    title: 'Explorar',
    links: [
      { label: 'Metodologia', href: '/#metodologia' },
      { label: 'Trilha A1–C2', href: '/#trilha' },
      { label: 'Teste de nível', href: '/#nivel' },
      { label: 'Planos', href: '/#planos' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Contato',
    links: [
      { label: phoneDisplay, href: whatsappLink('Olá, vim pelo site da Rise Idiomas.') },
      { label: site.email, href: `mailto:${site.email}` },
      { label: site.address, href: site.mapsUrl },
    ],
  },
];

const socialPaths: Record<string, string> = {
  Instagram:
    'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  LinkedIn:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  Facebook:
    'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  YouTube:
    'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
};
---

<footer class="ds-dark bg-abyss-deep relative overflow-hidden text-white">
  <div class="ds-grain-layer" aria-hidden="true"></div>

  <!-- ── Newsletter ────────────────────────────────────────────────────── -->
  <div class="ds-foot-band">
    <div class="ds-shell ds-foot-news">
      <div>
        <p class="ds-foot-kicker">Newsletter</p>
        <p class="ds-foot-statement">Uma dose de idioma na sua caixa de entrada</p>
        <p class="ds-foot-note">
          Vocabulário, cultura e método — o que a equipe escreve entre uma turma e outra. Sem spam.
        </p>
      </div>

      <div class="ds-foot-form">
        <NewsletterForm />
      </div>
    </div>
  </div>

  <!-- ── Grelha ────────────────────────────────────────────────────────── -->
  <div class="ds-foot-band">
    <div class="ds-shell ds-foot-grid">
      <div class="ds-foot-cell ds-foot-brand">
        <p class="ds-foot-mark">Rise Idiomas</p>
        <p class="ds-foot-note">
          Transformamos a maneira como você aprende uma segunda língua — uma jornada mais leve e
          eficaz, com foco em você e no seu crescimento.
        </p>

        <!-- Estado ao vivo, calculado a partir de site.hours -->
        <p class="ds-foot-status" data-open-status hidden>
          <span class="ds-foot-dot" aria-hidden="true"></span>
          <span data-open-label></span>
        </p>

        <ul class="ds-foot-social">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="ds-social"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={socialPaths[social.label]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((column, index) => (
          <nav aria-label={column.title} class="ds-foot-cell">
            <h2 class="ds-foot-col-title">
              <span class="ds-foot-col-num">{String(index + 1).padStart(2, '0')}</span>
              {column.title}
            </h2>
            <ul class="ds-foot-links">
              {column.links.map((link) => {
                const external = link.href.startsWith('http') || link.href.startsWith('mailto:');
                return (
                  <li>
                    <a
                      href={link.href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="ds-foot-link"
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <!-- ── Legal ─────────────────────────────────────────────────────────── -->
  <div class="ds-foot-band">
    <div class="ds-shell ds-foot-legal">
      <p>© {currentYear} Rise Idiomas · {site.address}</p>

      <div class="ds-foot-legal-right">
        <span class="flex items-center gap-2">
          <span class="ds-clock-dot" aria-hidden="true"></span>
          São Paulo <span id="rise-clock" class="text-white">--:--</span>
        </span>
        <span title="Idiomas ensinados na Rise">
          {site.languages.map((language) => language.slice(0, 3).toUpperCase()).join(' / ')}
        </span>
      </div>
    </div>
  </div>

  <!-- ── Assinatura ─────────────────────────────────────────────────────
       Sangra de margem a margem e é aparada em baixo pelo fim da página.
       `aria-hidden` porque o nome da marca já está no link do topo — aqui
       é ornamento, não conteúdo.                                        -->
  <div class="ds-wordmark-wrap">
    <p class="ds-wordmark" aria-hidden="true">RISE</p>
  </div>
</footer>

<script is:inline define:vars={{ hours: site.hours }}>
  (function () {
    const clock = document.getElementById('rise-clock');
    const status = document.querySelector('[data-open-status]');
    const statusLabel = document.querySelector('[data-open-label]');

    /** Hora de São Paulo, independentemente do fuso do visitante. */
    function readSaoPaulo() {
      const parts = new Intl.DateTimeFormat('pt-BR', {
        timeZone: 'America/Sao_Paulo',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(new Date());

      const get = (type) => (parts.find((part) => part.type === type) || {}).value || '';
      return {
        weekday: get('weekday').toLowerCase(),
        hour: Number(get('hour')),
        minute: Number(get('minute')),
        label: get('hour') + ':' + get('minute'),
      };
    }

    // Os intervalos vêm de site.hours; aqui só se decide em qual deles o dia
    // de hoje cai. Domingo não consta na lista — logo, fechado.
    const weekdayRange = hours[0].time.split(' - ');
    const saturdayRange = hours[1].time.split(' - ');

    function toMinutes(value) {
      const parts = value.split(':').map(Number);
      return parts[0] * 60 + parts[1];
    }

    function rangeForToday(weekday) {
      if (weekday.indexOf('dom') === 0) return null;
      if (weekday.indexOf('sáb') === 0 || weekday.indexOf('sab') === 0) return saturdayRange;
      return weekdayRange;
    }

    function tick() {
      const now = readSaoPaulo();
      if (clock) clock.textContent = now.label;
      if (!status || !statusLabel) return;

      const range = rangeForToday(now.weekday);
      const minutes = now.hour * 60 + now.minute;
      const open = range !== null && minutes >= toMinutes(range[0]) && minutes < toMinutes(range[1]);

      status.hidden = false;
      status.dataset.open = String(open);
      statusLabel.textContent = open
        ? 'Aberto agora · até ' + range[1]
        : 'Fechado · abre ' + weekdayRange[0];
    }

    tick();
    setInterval(tick, 30000);
  })();
</script>

<style>
  /* ── Faixas ─────────────────────────────────────────────────────────── */
  .ds-foot-band {
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--color-abyss-line) 45%, transparent);
  }

  .ds-foot-band:first-of-type {
    border-top: 0;
  }

  .ds-foot-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-abyss-ink) 60%, transparent);
  }

  .ds-foot-note {
    max-width: 26rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-abyss-ink);
  }

  /* ── Newsletter ─────────────────────────────────────────────────────── */
  .ds-foot-news {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 3.5rem;
  }

  @media (min-width: 940px) {
    .ds-foot-news {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .ds-foot-statement {
    max-width: 24rem;
    margin-top: 0.75rem;
    font-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
  }

  .ds-foot-form {
    flex-shrink: 0;
    width: 100%;
    max-width: 26rem;
  }

  /* ── Grelha de links ────────────────────────────────────────────────── */
  .ds-foot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 940px) {
    .ds-foot-grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }
  }

  /* Fios verticais desenhados nas células: é o que faz o rodapé ler como um
     plano, e não como listas soltas. */
  .ds-foot-cell {
    position: relative;
    padding: 2.5rem 0 2.5rem 1.5rem;
  }

  .ds-foot-cell + .ds-foot-cell::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background-color: color-mix(in srgb, var(--color-abyss-line) 45%, transparent);
  }

  .ds-foot-cell:first-child {
    padding-left: 0;
  }

  /* Em duas colunas a marca ocupa a linha inteira, e o fio só separa pares. */
  @media (max-width: 939px) {
    .ds-foot-brand {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    .ds-foot-cell:nth-child(even)::before {
      display: none;
    }

    .ds-foot-cell:nth-child(even) {
      padding-left: 0;
    }
  }

  .ds-foot-mark {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .ds-foot-col-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-abyss-ink);
  }

  .ds-foot-col-num {
    color: color-mix(in srgb, var(--color-abyss-ink) 45%, transparent);
  }

  .ds-foot-links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 1.25rem;
    list-style: none;
  }

  /* ── Estado ─────────────────────────────────────────────────────────── */
  .ds-foot-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.35rem 0.7rem;
    background-color: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-abyss-line) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-abyss-ink);
  }

  .ds-foot-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-abyss-ink) 60%, transparent);
  }

  .ds-foot-status[data-open='true'] {
    color: #fff;
  }

  .ds-foot-status[data-open='true'] .ds-foot-dot {
    background-color: var(--color-lime);
  }

  .ds-foot-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .ds-social {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-abyss-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-abyss-line) 80%, transparent);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-base) var(--ease-card);
  }

  .ds-social:hover {
    color: var(--color-abyss-deep);
    background-color: #fff;
    transform: translate3d(0, -2px, 0);
  }

  /* ── Links ──────────────────────────────────────────────────────────── */
  .ds-foot-link {
    position: relative;
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-abyss-ink);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Sublinhado que cresce da esquerda — só transform. */
  .ds-foot-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-card);
  }

  .ds-foot-link:hover {
    color: #fff;
  }

  .ds-foot-link:hover::after {
    transform: scaleX(1);
  }

  /* ── Legal ──────────────────────────────────────────────────────────── */
  .ds-foot-legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-abyss-ink) 60%, transparent);
  }

  @media (min-width: 640px) {
    .ds-foot-legal {
      flex-direction: row;
      text-align: left;
    }
  }

  .ds-foot-legal-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* ── Wordmark ───────────────────────────────────────────────────────── */
  .ds-wordmark-wrap {
    position: relative;
    overflow: hidden;
    /* Apara a palavra em baixo: fica presa ao fim da página em vez de
       flutuar num vão. */
    height: clamp(3.5rem, 26vw, 23rem);
  }

  .ds-wordmark {
    margin: 0;
    /* Dimensionada para ocupar a largura do container. */
    font-size: clamp(5rem, 46vw, 40rem);
    line-height: 0.78;
    font-weight: 700;
    letter-spacing: -0.07em;
    text-align: center;
    white-space: nowrap;
    user-select: none;

    color: transparent;
    -webkit-text-stroke: 1.25px color-mix(in srgb, var(--color-brand-400) 55%, transparent);
    /* O preenchimento é uma faixa de altura zero ancorada em baixo; no hover
       ela sobe até cobrir a palavra. Anima background-size, que não mexe em
       layout nenhum. */
    background-image: linear-gradient(180deg, var(--color-brand-400), var(--color-aqua));
    -webkit-background-clip: text;
    background-clip: text;
    background-size: 100% 0%;
    background-repeat: no-repeat;
    background-position: 50% 100%;
    transition:
      background-size var(--dur-scene) var(--ease-card),
      -webkit-text-stroke-color var(--dur-base) var(--ease);
  }

  @media (hover: hover) {
    .ds-wordmark-wrap:hover .ds-wordmark {
      background-size: 100% 100%;
      -webkit-text-stroke-color: transparent;
    }
  }

  /* ── Relógio ────────────────────────────────────────────────────────── */
  .ds-clock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-lime);
    box-shadow: 0 0 0 0 rgba(180, 244, 97, 0.6);
    animation: ds-clock-pulse 2.6s ease-out infinite;
  }

  @keyframes ds-clock-pulse {
    70% {
      box-shadow: 0 0 0 6px rgba(180, 244, 97, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(180, 244, 97, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-clock-dot {
      animation: none;
    }
  }
</style>
